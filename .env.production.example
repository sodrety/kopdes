APP_ENV=production
APP_ADDRESS=:8080
DATABASE_DRIVER=pgx
COOKIE_SECURE=true
APP_IMAGE=ghcr.io/sodrety/kopdes:latest

POSTGRES_DB=kopdes
POSTGRES_USER=kopdes
POSTGRES_PASSWORD=replace_with_strong_database_password

JWT_SECRET=replace_with_at_least_32_random_characters

KETUA_UTAMA_MEMBER_ID=ketua-utama-bootstrap
KETUA_UTAMA_EMAIL=ketua-utama@koperasidj.id
KETUA_UTAMA_PASSWORD=replace_with_temporary_bootstrap_password

SERVICE_NAME=kopdes-production
SERVICE_VERSION=production
METRICS_ENABLED=true
TRACING_ENABLED=false
TRACING_EXPORTER=stdout
TRACING_ENDPOINT=
TRACING_INSECURE=false
