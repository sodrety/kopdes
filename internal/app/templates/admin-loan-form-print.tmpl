{{define "admin-loan-form-print"}}
<!doctype html>
<html lang="{{.Lang}}">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>{{.Title}}</title>
  <style>
    @page { size: A4 portrait; margin: 0; }
    * { box-sizing: border-box; }
    html, body { margin: 0; min-height: 100%; color: #111; background: #eee; font: 14px/1.4 Arial, Helvetica, sans-serif; }
    .loan-form-actions { display: flex; justify-content: center; gap: 12px; padding: 18px; }
    .loan-form-actions a, .loan-form-actions button { border: 1px solid #333; border-radius: 4px; background: #fff; color: #111; padding: 9px 14px; font: inherit; text-decoration: none; cursor: pointer; }
    .loan-form-page { position: relative; width: min(210mm, calc(100vw - 32px)); aspect-ratio: 210 / 297; margin: 0 auto 24px; overflow: hidden; background: #fff; box-shadow: 0 2px 12px #0003; }
    .loan-form-background { position: absolute; inset: 0; display: block; width: 100%; height: 100%; object-fit: fill; }
    .loan-form-mask { position: absolute; background: #fff; }
    .loan-form-field { position: absolute; display: block; color: #000; font-family: Helvetica, Arial, sans-serif; font-weight: 400; line-height: 1; white-space: nowrap; transform: translateY(-0.8em); }
    @media print {
      html, body { width: 210mm; height: 297mm; min-height: 0; background: #fff; }
      .loan-form-actions { display: none; }
      .loan-form-page { width: 210mm; height: 297mm; aspect-ratio: auto; margin: 0; box-shadow: none; break-after: avoid; }
    }
  </style>
</head>
<body>
  <nav class="loan-form-actions" aria-label="{{.Title}}">
    <a href="{{.BackURL}}">{{t .Lang "loan_form_back"}}</a>
    <button type="button" onclick="window.print()">{{t .Lang "loan_form_print"}}</button>
  </nav>
  <main class="loan-form-page">
    <img class="loan-form-background" src="{{.BackgroundDataURI}}" alt="">
    {{range .Masks}}
    <span class="loan-form-mask" style="left:{{printf "%.4f" .Left}}%;top:{{printf "%.4f" .Top}}%;width:{{printf "%.4f" .Width}}%;height:{{printf "%.4f" .Height}}%"></span>
    {{end}}
    {{range .Fields}}
    <span class="loan-form-field" style="left:{{printf "%.4f" .Left}}%;top:{{printf "%.4f" .Top}}%;font-size:{{printf "%.2f" .FontSize}}pt">{{.Value}}</span>
    {{end}}
  </main>
  <script>window.addEventListener("load", function () { window.print(); });</script>
</body>
</html>
{{end}}
