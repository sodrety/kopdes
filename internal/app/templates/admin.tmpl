                    <label>{{t $.Lang "coa_account"}} <span class="field-help">({{t $.Lang "pending_mapping"}})</span><select name="coa_code"><option value="">{{t $.Lang "select_coa_account"}}</option>{{range $.COAAccounts}}<option value="{{.Code}}">{{.Code}} - {{.Name}}</option>{{end}}</select></label>
                    <input name="note" placeholder="{{t $.Lang "approval_note_optional"}}" aria-label="{{t $.Lang "approval_note_optional"}}">
                    <button type="submit">{{t $.Lang "approve"}}</button>
