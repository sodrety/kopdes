        {{if .Entries}}
{{template "table-open" .}}
          <thead><tr><th>{{t $.Lang "date"}}</th><th>{{t $.Lang "reference"}}</th><th>{{t $.Lang "transaction_type"}}</th><th>{{t $.Lang "description"}}</th><th>{{t $.Lang "journal_lines"}}</th><th>{{t $.Lang "debit"}}</th><th>{{t $.Lang "credit"}}</th><th>{{t $.Lang "status"}}</th><th>{{t $.Lang "action"}}</th></tr></thead>
          <tbody>{{range .Entries}}<tr>
            <td>{{.Date}}</td><td>{{.ReferenceNo}}</td><td>{{t $.Lang (printf "transaction_type_%s" .TransactionType)}}</td><td>{{.Description}}{{if .CorrectionReason}}<small>{{t $.Lang "correction_reason"}}: {{.CorrectionReason}}</small>{{end}}{{if .ReversalOf}}<small>{{t $.Lang "reversal_of"}} {{.ReversalOf}}</small>{{end}}</td>
            <td>
              <div class="journal-line-groups">
                <div class="journal-line-group journal-line-group-debit">
                  <strong class="journal-line-group-title">{{t $.Lang "debit"}}</strong>
                  {{range .Lines}}{{if eq .Side "debit"}}<div class="journal-line-item"><span>{{if .COACode}}{{.COACode}} — {{.COAName}}{{else}}{{t $.Lang "pending_mapping"}}{{end}}</span><strong>Rp {{nominal .Amount}}</strong></div>{{end}}{{end}}
                </div>
                <div class="journal-line-group journal-line-group-credit">
                  <strong class="journal-line-group-title">{{t $.Lang "credit"}}</strong>
                  {{range .Lines}}{{if eq .Side "credit"}}<div class="journal-line-item"><span>{{if .COACode}}{{.COACode}} — {{.COAName}}{{else}}{{t $.Lang "pending_mapping"}}{{end}}</span><strong>Rp {{nominal .Amount}}</strong></div>{{end}}{{end}}
                </div>
              </div>
            </td>
            <td>Rp {{nominal .TotalDebit}}</td><td>Rp {{nominal .TotalCredit}}</td><td>{{t $.Lang (printf "journal_status_%s" .Status)}}</td>
            <td>{{if and $.CanRecord .CanReverse}}<form method="post" action="/api/admin/journals/{{.ID}}/reverse" hx-post="/api/admin/journals/{{.ID}}/reverse" hx-target="#journal-reversal-error" hx-swap="innerHTML"><label>{{t $.Lang "correction_reason"}} <input name="reason" maxlength="500" required></label><label>{{t $.Lang "date"}} <input name="date" type="date" value="{{$.DefaultDate}}" required></label><button type="submit">{{t $.Lang "reverse_journal"}}</button></form>{{else if .ReversalOf}}{{t $.Lang "journal_reversed"}}{{else}}—{{end}}</td>
