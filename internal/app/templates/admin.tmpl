              <option value="cash" {{if eq .Filters.Source "cash"}}selected{{end}}>{{t .Lang "source_cash"}}</option>
              <option value="bank" {{if eq .Filters.Source "bank"}}selected{{end}}>{{t .Lang "source_bank"}}</option>
            </select>
          </label>
          <label>{{t .Lang "coa_account"}}
            <select name="transaction_category">
              <option value="">{{t .Lang "all_categories"}}</option>
              {{range .COAAccounts}}<option value="{{.Code}}" {{if eq $.Filters.TransactionCategory .Code}}selected{{end}}>{{.Code}} — {{.Name}}</option>{{end}}
            </select>
          </label>
          <button type="submit">{{t .Lang "apply_filters"}}</button>
          <a class="button-link button-link-secondary" href="/admin/transactions">{{t .Lang "reset"}}</a>
        </form>
        {{if .Transactions}}
{{template "table-open" .}}
          <thead>
            <tr>
              <th>{{t $.Lang "select_transactions"}}</th>
              <th>{{t $.Lang "date"}}</th>
              <th>{{t $.Lang "description"}}</th>
              <th>{{t $.Lang "direction"}}</th>
              <th>{{t $.Lang "transaction_source"}}</th>
              <th>{{t $.Lang "source"}}</th>
              <th>{{t $.Lang "coa_account"}}</th>
              <th>{{t $.Lang "cash_in"}}</th>
              <th>{{t $.Lang "cash_out"}}</th>
              <th>{{t $.Lang "amount"}}</th>
              <th>{{t $.Lang "member"}}</th>
              <th>{{t $.Lang "reference"}}</th>
              <th>{{t $.Lang "recorded_by"}}</th>
            </tr>
          </thead>
          <tbody>
            {{range .Transactions}}
            <tr>
              <td><input form="bulk-source-form" type="checkbox" name="ids" value="{{.ID}}" aria-label="{{t $.Lang "select_transaction"}}"></td>
              <td>{{.TransactionDate}}</td>
              <td>{{.Description}}</td>
              <td>{{t $.Lang .Direction}}</td>
              <td>{{t $.Lang (printf "transaction_type_%s" .Type)}}</td>
              <td>
                <form method="post" action="/api/admin/transactions/{{.ID}}/source" class="inline-source-form">
                  <select name="source" aria-label="{{t $.Lang "source"}}" onchange="this.form.submit()">
                    <option value="cash" {{if eq .Source "cash"}}selected{{end}}>{{t $.Lang "source_cash"}}</option>
                    <option value="bank" {{if eq .Source "bank"}}selected{{end}}>{{t $.Lang "source_bank"}}</option>
                  </select>
                </form>
              </td>
              <td>{{if .COACode}}{{.COACode}}{{else if .Category}}{{.Category}}{{else}}{{t $.Lang "pending_mapping"}}{{end}}</td>
              <td>{{if gt .Income 0}}Rp {{nominal .Income}}{{else}}-{{end}}</td>
              <td>{{if gt .Expense 0}}Rp {{nominal .Expense}}{{else}}-{{end}}</td>
              <td>Rp {{nominal .Amount}}</td>
              <td>{{if .FullName}}{{template "member-table-cell" .}}{{else}}-{{end}}</td>
              <td>{{.ReferenceNo}}</td>
              <td>{{if .RecordedBy}}{{.RecordedBy}}{{else}}-{{end}}</td>
            </tr>
            {{end}}
          </tbody>
{{template "table-close" .}}
        {{else}}
{{template "empty-state" (t .Lang "no_cash_transactions")}}
        {{end}}
      </section>
      <script>
        window.confirmManualCashTransaction = function (form) {
          var direction = form.elements.direction;
          var source = form.elements.source;
          var coa = form.elements.coa_code;
          var values = [
            direction.options[direction.selectedIndex].text,
            source.options[source.selectedIndex].text,
            coa.options[coa.selectedIndex].text,
            form.elements.transaction_date.value,
            form.elements.amount.value,
            form.elements.description.value
          ];
          var message = form.dataset.confirmTemplate;
          values.forEach(function (value) { message = message.replace("%s", value); });
          return window.confirm(message);
        };
        document.addEventListener("DOMContentLoaded", function () {});
      </script>
{{template "admin-shell-end" .}}
{{end}}

{{define "admin-transaction-categories"}}
{{template "admin-shell-start" .}}
      <section class="panel">
        <div class="section-heading-row">
          <div><h2>{{t .Lang "cash_transaction_category"}}</h2><p class="field-help">{{t .Lang "categories_description"}}</p></div>
          <div class="button-row"><a class="button-link button-link-secondary" href="/api/admin/transaction-categories/template.xlsx">{{t .Lang "download_category_template"}}</a><a class="button-link button-link-secondary" href="/admin/transactions">{{t .Lang "cash_transactions"}}</a></div>
        </div>
