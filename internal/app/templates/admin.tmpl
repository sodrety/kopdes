              <option value="pending" {{if eq .LoanRequestStatus "pending"}}selected{{end}}>{{t .Lang "pending"}}</option>
              <option value="approved" {{if eq .LoanRequestStatus "approved"}}selected{{end}}>{{t .Lang "approved"}}</option>
              <option value="rejected" {{if eq .LoanRequestStatus "rejected"}}selected{{end}}>{{t .Lang "rejected"}}</option>
              <option value="cancelled" {{if eq .LoanRequestStatus "cancelled"}}selected{{end}}>{{t .Lang "status_cancelled"}}</option>
