                  <form class="inline-rejection-form" method="post" action="/api/admin/withdrawal-requests/{{.ID}}/override-reject" hx-post="/api/admin/withdrawal-requests/{{.ID}}/override-reject" hx-target="#withdrawal-review-error" hx-swap="innerHTML">
