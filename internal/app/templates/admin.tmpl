        {{if .Ledger}}{{template "table-open" .}}<thead><tr><th>{{t $.Lang "date"}}</th><th>{{t $.Lang "reference"}}</th><th>{{t $.Lang "description"}}</th><th>{{t $.Lang "debit"}}</th><th>{{t $.Lang "credit"}}</th><th>{{t $.Lang "balance"}}</th></tr></thead><tbody>{{range .Ledger}}<tr><td>{{.Date}}</td><td>{{.ReferenceNo}}</td><td>{{.Description}}</td><td>{{if .Debit}}Rp {{nominal .Debit}}{{else}}—{{end}}</td><td>{{if .Credit}}Rp {{nominal .Credit}}{{else}}—{{end}}</td><td>Rp {{nominal .Balance}}</td></tr>{{end}}</tbody>{{template "table-close" .}}{{else}}{{template "empty-state" (t .Lang "no_journal_entries")}}{{end}}
        <p><strong>{{t .Lang "ending_balance"}}: Rp {{nominal .LedgerEnding}}</strong></p>{{else}}{{template "empty-state" (t .Lang "select_coa_account")}}{{end}}
      </section>
      {{else}}
      <section class="panel">
        <h2>{{t .Lang "trial_balance"}}</h2>
        <form class="filter-form" method="get" action="/admin/journals"><input type="hidden" name="view" value="trial_balance"><label>{{t .Lang "date_from"}} <input name="date_from" type="date" value="{{.DateFrom}}"></label><label>{{t .Lang "date_to"}} <input name="date_to" type="date" value="{{.DateTo}}"></label><button type="submit">{{t .Lang "apply_filters"}}</button></form>
        {{if .TrialBalance}}{{template "table-open" .}}<thead><tr><th>{{t $.Lang "coa_account"}}</th><th>{{t $.Lang "account_type"}}</th><th>{{t $.Lang "debit"}}</th><th>{{t $.Lang "credit"}}</th><th>{{t $.Lang "balance"}}</th></tr></thead><tbody>{{range .TrialBalance}}<tr><td>{{.Code}} — {{.Name}}</td><td>{{t $.Lang (printf "account_type_%s" .AccountType)}}</td><td>Rp {{nominal .Debit}}</td><td>Rp {{nominal .Credit}}</td><td>Rp {{nominal .Balance}}</td></tr>{{end}}<tr class="balance-total-row"><td colspan="2">{{t $.Lang "total"}}</td><td>Rp {{nominal .TrialDebit}}</td><td>Rp {{nominal .TrialCredit}}</td><td>—</td></tr></tbody>{{template "table-close" .}}{{else}}{{template "empty-state" (t .Lang "no_journal_entries")}}{{end}}
      </section>
      {{end}}
      <script>
        (function () {
          var body = document.querySelector('[data-journal-lines]');
          var add = document.querySelector('[data-add-journal-line]');
          var summary = document.querySelector('[data-journal-balance]');
          if (!body || !add || !summary) return;
          var form = body.closest('form');
          var submit = form.querySelector('[data-journal-submit]');
          var debitOutput = summary.querySelector('[data-journal-debit-total]');
          var creditOutput = summary.querySelector('[data-journal-credit-total]');
          var differenceOutput = summary.querySelector('[data-journal-difference]');
          var statusOutput = summary.querySelector('[data-journal-balance-status]');
          var maximumAmount = 9223372036854775807n;
          function amountDigits(value) {
            var normalized = String(value || '').trim().replace(/^rp\s*/i, '');
            if (!normalized) return '0';
            if (/^\d+$/.test(normalized)) return normalized.replace(/^0+(?=\d)/, '');
            if (/^\d{1,3}([.,]\d{3})+$/.test(normalized) && !(normalized.includes('.') && normalized.includes(','))) {
              return normalized.replace(/[.,]/g, '').replace(/^0+(?=\d)/, '');
            }
            return null;
          }
          function totalFor(name) {
            var total = 0n;
            var valid = true;
            body.querySelectorAll('[name="' + name + '"]').forEach(function (input) {
              var digits = amountDigits(input.value);
              if (digits === null) {
                valid = false;
                return;
              }
              total += BigInt(digits);
            });
            return valid && total <= maximumAmount ? total : null;
          }
          function formattedAmount(amount) {
            var separator = summary.dataset.groupSeparator || ',';
            return amount.toString().replace(/\B(?=(\d{3})+(?!\d))/g, separator);
          }
          function updateBalance() {
            var debit = totalFor('debit_amount');
            var credit = totalFor('credit_amount');
            var validTotals = debit !== null && credit !== null;
            var difference = validTotals ? (debit >= credit ? debit - credit : credit - debit) : null;
            debitOutput.textContent = debit === null ? '—' : formattedAmount(debit);
            creditOutput.textContent = credit === null ? '—' : formattedAmount(credit);
            differenceOutput.textContent = difference === null ? '—' : formattedAmount(difference);
            var balanced = validTotals && debit > 0n && debit === credit;
            summary.dataset.balanced = balanced ? 'true' : 'false';
            statusOutput.textContent = balanced ? summary.dataset.balancedMessage : summary.dataset.unbalancedMessage;
            submit.disabled = !balanced;
          }
          form.addEventListener('input', updateBalance);
          form.addEventListener('change', updateBalance);
          form.addEventListener('submit', function (event) {
            updateBalance();
            if (submit.disabled) event.preventDefault();
          });
          add.addEventListener('click', function () {
            var row = body.querySelector('[data-journal-line]').cloneNode(true);
            row.querySelectorAll('input').forEach(function (input) { input.value = ''; });
            row.querySelector('select').selectedIndex = 0;
            body.appendChild(row);
            updateBalance();
          });
          body.addEventListener('click', function (event) {
            if (event.target.matches('[data-remove-journal-line]') && body.querySelectorAll('[data-journal-line]').length > 2) {
              event.target.closest('[data-journal-line]').remove();
              updateBalance();
            }
          });
          updateBalance();
        }());
      </script>
{{template "admin-shell-end" .}}
{{end}}

