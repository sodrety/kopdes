{{define "admin-dashboard"}}
{{template "admin-shell-start" .}}
      <section class="summary-grid">
{{template "summary-card" (dict "Label" (t .Lang "total_members") "Value" .Summary.TotalMembers "Icon" "users")}}
{{template "summary-card" (dict "Label" (t .Lang "active_members") "Value" .Summary.ActiveMembers "Icon" "user-check")}}
{{template "summary-card" (dict "Label" (t .Lang "total_savings") "Value" (nominal .Summary.TotalSavings) "Icon" "piggy-bank")}}
{{template "summary-card" (dict "Label" (t .Lang "active_loans") "Value" .Summary.ActiveLoans "Icon" "landmark")}}
{{template "summary-card" (dict "Label" (t .Lang "outstanding_loan") "Value" (nominal .Summary.TotalOutstandingLoan) "Icon" "banknote")}}
{{template "summary-card" (dict "Label" (t .Lang "pending_requests") "Value" .Summary.PendingLoanRequests "Icon" "file-clock")}}
      </section>
      <section class="dashboard-line-grid">
{{template "line-chart" (dict "Lang" .Lang "Chart" .Reports.SavingsLoanComparison "Size" "line-chart-wide")}}
{{template "line-chart" (dict "Lang" .Lang "Chart" .Reports.BalanceTrend "Size" "line-chart-compact")}}
      </section>
      <section class="dashboard-home-grid">
        <article class="panel dashboard-activity-card">
          <header class="panel-header">
            <h2>{{t .Lang "recent_activity"}}</h2>
          </header>
          {{if .Reports.Repayments}}
{{template "table-open" .}}
            <thead>
              <tr>
                <th>{{t $.Lang "date"}}</th>
                <th>{{t $.Lang "category"}}</th>
                <th>{{t $.Lang "description"}}</th>
                <th>{{t $.Lang "amount"}}</th>
              </tr>
            </thead>
            <tbody>
              {{range .Reports.Repayments}}
              <tr>
                <td>{{.RecordDate}}</td>
                <td>{{t $.Lang (printf "repayment_type_%s" .Type)}}</td>
                <td>{{.FullName}} - {{.ReferenceNo}}</td>
                <td>{{nominal .Amount}}</td>
              </tr>
              {{end}}
            </tbody>
{{template "table-close" .}}
          {{else if .Reports.Loans}}
{{template "table-open" .}}
            <thead>
              <tr>
                <th>{{t $.Lang "date"}}</th>
                <th>{{t $.Lang "category"}}</th>
                <th>{{t $.Lang "description"}}</th>
                <th>{{t $.Lang "amount"}}</th>
              </tr>
            </thead>
            <tbody>
              {{range .Reports.Loans}}
              <tr>
                <td>{{.CreatedAt}}</td>
                <td>{{t $.Lang "pinjaman"}}</td>
                <td>{{.FullName}}</td>
                <td>{{nominal .ApprovedAmount}}</td>
              </tr>
              {{end}}
            </tbody>
{{template "table-close" .}}
          {{else}}
{{template "empty-state" (t .Lang "no_report_data")}}
          {{end}}
        </article>
        <article class="panel dashboard-quick-card">
          <header class="panel-header">
            <h2>{{t .Lang "quick_actions"}}</h2>
          </header>
          <div class="dashboard-quick-list">
            <a href="/admin/members/new"><i data-lucide="user-plus"></i><span>{{t .Lang "create_member"}}</span></a>
            <a href="/admin/savings/new"><i data-lucide="piggy-bank"></i><span>{{t .Lang "record_saving"}}</span></a>
            <a href="/admin/loan-requests"><i data-lucide="file-clock"></i><span>{{t .Lang "loan_requests"}}</span></a>
            <a href="/admin/reports/balance"><i data-lucide="scale"></i><span>{{t .Lang "balance_report"}}</span></a>
          </div>
        </article>
      </section>
{{template "admin-shell-end" .}}
{{end}}

{{define "admin-loan-disbursements"}}
{{template "admin-shell-start" .}}
  <section class="panel">
    <h2>{{t .Lang "loan_disbursements"}}</h2>
    <p class="field-help">{{t .Lang "loan_disbursements_description"}}</p>
    {{if .LoanRequests}}
{{template "table-open" .}}
      <thead>
        <tr>
          <th>{{t $.Lang "member"}}</th>
          <th>{{t $.Lang "approved_amount"}}</th>
          <th>{{t $.Lang "duration"}}</th>
          <th>{{t $.Lang "purpose"}}</th>
          <th>{{t $.Lang "loan_disbursement_date"}}</th>
        </tr>
      </thead>
      <tbody>
        {{range .LoanRequests}}
        <tr>
          <td>{{template "member-table-cell" .}}</td>
          <td>{{if gt .ProposedApprovedAmount 0}}{{nominal .ProposedApprovedAmount}}{{else}}{{nominal .RequestedAmount}}{{end}}</td>
          <td>{{if gt .ProposedDurationMonths 0}}{{.ProposedDurationMonths}}{{else}}{{.DurationMonths}}{{end}} {{t $.Lang "months"}}</td>
          <td>{{.Purpose}}</td>
          <td>
            <form method="post" action="/api/admin/loan-requests/{{.ID}}/disburse" hx-post="/api/admin/loan-requests/{{.ID}}/disburse" hx-target="#loan-disbursement-error" hx-swap="innerHTML">
              <label>{{t $.Lang "loan_disbursement_date"}}
                <input name="disbursement_date" type="date" max="{{$.CurrentDate}}" value="{{$.CurrentDate}}" required aria-label="{{t $.Lang "loan_disbursement_date"}}">
              </label>
              <button type="submit">{{t $.Lang "record_loan_disbursement"}}</button>
            </form>
          </td>
        </tr>
        {{end}}
      </tbody>
{{template "table-close" .}}
    {{else}}
{{template "empty-state" (t .Lang "no_loans_waiting_disbursement")}}
    {{end}}
    {{template "form-error" (dict "ID" "loan-disbursement-error")}}
  </section>
{{template "admin-shell-end" .}}
{{end}}

{{define "admin-loan-request-batch"}}
{{template "admin-shell-start" .}}
      <section class="page-actions">
        <a class="button-link button-link-secondary" href="/api/admin/loan-request-batches/{{.Batch.ID}}/export.xlsx">{{t .Lang "admin_loan_batch_export"}}</a>
        <a class="button-link button-link-secondary" href="/admin/loan-requests?batch_id={{.Batch.ID}}">{{t .Lang "loan_requests"}}</a>
      </section>
      <section class="panel">
        <h2>{{t .Lang "admin_loan_batch_heading"}}</h2>
        <p class="field-help">{{t .Lang "admin_loan_batch_description"}}</p>
        <div class="detail-grid">
          <div><span>{{t .Lang "admin_loan_batch_id"}}</span><strong>{{.Batch.ID}}</strong></div>
          <div><span>{{t .Lang "admin_loan_creator"}}</span><strong>{{.Batch.CreatedByName}}</strong></div>
          <div><span>{{t .Lang "created"}}</span><strong>{{.Batch.CreatedAt}}</strong></div>
          <div><span>{{t .Lang "admin_loan_batch_status"}}</span><strong>{{t .Lang (printf "admin_loan_batch_status_%s" .Batch.Status)}}</strong></div>
          <div><span>{{t .Lang "admin_loan_batch_rows"}}</span><strong>{{.Batch.RowCount}}</strong></div>
          <div><span>{{t .Lang "created"}}</span><strong>{{.Batch.CreatedCount}}</strong></div>
          <div><span>{{t .Lang "error"}}</span><strong>{{.Batch.ErrorCount}}</strong></div>
          <div><span>{{t .Lang "warning"}}</span><strong>{{.Batch.WarningCount}}</strong></div>
          <div><span>{{t .Lang "pending"}}</span><strong>{{.Batch.PendingCount}}</strong></div>
          <div><span>{{t .Lang "approved"}}</span><strong>{{.Batch.ApprovedCount}}</strong></div>
          <div><span>{{t .Lang "rejected"}}</span><strong>{{.Batch.RejectedCount}}</strong></div>
          <div><span>{{t .Lang "status_cancelled"}}</span><strong>{{.Batch.CancelledCount}}</strong></div>
        </div>
        {{if .Batch.BatchWarnings}}
        <div class="notice notice-warning"><strong>{{t .Lang "warning"}}</strong><ul>{{range .Batch.BatchWarnings}}<li>{{t $.Lang .}}</li>{{end}}</ul></div>
        {{end}}
        {{if .Batch.CanConfirm}}
        <form method="post" action="/api/admin/loan-requests/bulk/{{.Batch.ID}}/commit" hx-post="/api/admin/loan-requests/bulk/{{.Batch.ID}}/commit" hx-target="#admin-loan-batch-error" hx-swap="innerHTML">
          <p class="field-help">{{t .Lang "admin_loan_batch_confirm_help"}}</p>
          <label class="remember-field"><input name="acknowledge_warnings" type="checkbox" {{if .Batch.WarningCount}}required{{end}}> {{t .Lang "acknowledge_admin_loan_warnings"}}</label>
          <button type="submit">{{t .Lang "admin_loan_batch_commit"}}</button>
        </form>
        {{end}}
        {{template "form-error" (dict "ID" "admin-loan-batch-error")}}
      </section>
      <section class="panel">
        <h2>{{t .Lang "admin_loan_batch_rows"}}</h2>
        {{if .Batch.Rows}}
{{template "table-open" .}}
          <thead><tr><th>#</th><th>{{t .Lang "member_no"}}</th><th>{{t .Lang "name"}}</th><th>{{t .Lang "loan_type"}}</th><th>{{t .Lang "amount"}}</th><th>{{t .Lang "duration"}}</th><th>{{t .Lang "purpose"}}</th><th>{{t .Lang "status"}}</th><th>{{t .Lang "error"}}</th><th>{{t .Lang "warning"}}</th><th>{{t .Lang "loan_id"}}</th></tr></thead>
          <tbody>
            {{range .Batch.Rows}}
            <tr>
              <td>{{.ExcelRow}}</td><td>{{.MemberNo}}</td><td>{{.FullName}}</td><td>{{template "loan-type-label" (dict "Lang" $.Lang "LoanType" .LoanType "LegacyTerms" false)}}</td><td>{{if .RequestedAmount}}{{nominal .RequestedAmount}}{{else}}{{t $.Lang "none"}}{{end}}</td><td>{{if .DurationMonths}}{{.DurationMonths}} {{t $.Lang "months"}}{{else}}{{t $.Lang "none"}}{{end}}</td><td>{{.Purpose}}</td><td>{{t $.Lang (printf "admin_loan_row_status_%s" .Status)}}</td>
              <td>{{range .Errors}}<div>{{t $.Lang .}}</div>{{end}}</td><td>{{range .Warnings}}<div>{{t $.Lang .}}</div>{{end}}</td><td>{{if .RequestID}}<a href="/admin/loan-requests?status=pending&batch_id={{$.Batch.ID}}">{{.RequestID}}</a>{{else}}{{t $.Lang "none"}}{{end}}</td>
            </tr>
            {{end}}
          </tbody>
{{template "table-close" .}}
        {{else}}
        <p>{{t .Lang "admin_issue_invalid_template"}}</p>
        {{end}}
      </section>
{{template "admin-shell-end" .}}
{{end}}

{{define "admin-reports"}}
{{template "admin-shell-start" .}}
      <section class="page-actions">
        <a class="button-link button-link-secondary" href="/admin/reports/balance">{{t .Lang "balance_report"}}</a>
      </section>
      <section class="chart-grid">
        <article class="panel chart-panel">
          <h2>{{t .Lang "simpanan_by_category"}}</h2>
{{template "bar-chart" (dict "Lang" .Lang "TitleKey" "simpanan_by_category" "Format" "currency" "Segments" .Reports.SavingsByCategory)}}
        </article>
        <article class="panel chart-panel">
          <h2>{{t .Lang "penarikan_by_status"}}</h2>
{{template "bar-chart" (dict "Lang" .Lang "TitleKey" "penarikan_by_status" "Format" "count" "Segments" .Reports.WithdrawalsByStatus)}}
        </article>
        <article class="panel chart-panel">
          <h2>{{t .Lang "pinjaman_exposure"}}</h2>
{{template "bar-chart" (dict "Lang" .Lang "TitleKey" "pinjaman_exposure" "Format" "currency" "Segments" .Reports.LoanExposure)}}
        </article>
        <article class="panel chart-panel">
          <h2>{{t .Lang "angsuran_progress"}}</h2>
{{template "bar-chart" (dict "Lang" .Lang "TitleKey" "angsuran_progress" "Format" "currency" "Segments" .Reports.RepaymentProgress)}}
        </article>
      </section>
      <section class="panel">
        <h2>{{t .Lang "simpanan_report"}}</h2>
        {{if .Reports.SavingsByMember}}
{{template "table-open" .}}
          <thead>
            <tr>
              <th>{{t $.Lang "member"}}</th>
              <th>{{t $.Lang "member_type"}}</th>
              <th>{{t $.Lang "simpanan_pokok"}}</th>
              <th>{{t $.Lang "simpanan_wajib"}}</th>
              <th>{{t $.Lang "simpanan_sukarela"}}</th>
              <th>{{t $.Lang "total"}}</th>
            </tr>
          </thead>
          <tbody>
            {{range .Reports.SavingsByMember}}
            <tr>
              <td>{{template "member-table-cell" .}}</td>
              <td>{{.MemberTypeLabel}}</td>
              <td>{{nominal .Pokok}}</td>
              <td>{{nominal .Wajib}}</td>
              <td>{{nominal .Sukarela}}</td>
              <td>{{nominal .Total}}</td>
            </tr>
            {{end}}
          </tbody>
{{template "table-close" .}}
        {{else}}
{{template "empty-state" (t .Lang "no_report_data")}}
        {{end}}
      </section>
      <section class="panel">
        <h2>{{t .Lang "penarikan_report"}}</h2>
        {{if .Reports.WithdrawalsByMember}}
{{template "table-open" .}}
          <thead>
            <tr>
              <th>{{t $.Lang "member"}}</th>
              <th>{{t $.Lang "member_type"}}</th>
              <th>{{t $.Lang "status_pending"}}</th>
              <th>{{t $.Lang "status_approved"}}</th>
              <th>{{t $.Lang "status_rejected"}}</th>
              <th>{{t $.Lang "total"}}</th>
            </tr>
          </thead>
          <tbody>
            {{range .Reports.WithdrawalsByMember}}
            <tr>
              <td>{{template "member-table-cell" .}}</td>
              <td>{{.MemberTypeLabel}}</td>
              <td>{{.Pending}}</td>
              <td>{{.Approved}}</td>
              <td>{{.Rejected}}</td>
              <td>{{nominal .Total}}</td>
            </tr>
            {{end}}
          </tbody>
{{template "table-close" .}}
        {{else}}
{{template "empty-state" (t .Lang "no_report_data")}}
        {{end}}
      </section>
      <section class="panel">
        <h2>{{t .Lang "pinjaman_report"}}</h2>
        {{if .Reports.Loans}}
{{template "table-open" .}}
          <thead>
            <tr>
              <th>{{t $.Lang "member"}}</th>
              <th>{{t $.Lang "member_type"}}</th>
              <th>{{t $.Lang "approved_amount"}}</th>
              <th>{{t $.Lang "start_date"}}</th>
			  <th>{{t $.Lang "monthly_admin_fee"}}</th>
              <th>{{t $.Lang "total_obligation"}}</th>
              <th>{{t $.Lang "monthly_installment"}}</th>
              <th>{{t $.Lang "remaining_balance"}}</th>
              <th>{{t $.Lang "next_due_date"}}</th>
              <th>{{t $.Lang "final_due_date"}}</th>
              <th>{{t $.Lang "status"}}</th>
            </tr>
          </thead>
          <tbody>
            {{range .Reports.Loans}}
            <tr>
              <td>{{template "member-table-cell" .}}</td>
              <td>{{.MemberTypeLabel}}</td>
              <td>{{nominal .ApprovedAmount}}</td>
              <td>{{.StartDate}}</td>
			  <td>{{nominal .MonthlyAdminFee}}</td>
              <td>{{nominal .TotalObligation}}</td>
              <td>{{nominal .MonthlyInstallment}}</td>
              <td>{{nominal .RemainingBalance}}</td>
              <td>{{.NextDueDate}}</td>
              <td>{{.FinalDueDate}}</td>
              <td>{{template "status-badge" (dict "Lang" $.Lang "Status" .Status)}}</td>
            </tr>
            {{end}}
          </tbody>
{{template "table-close" .}}
        {{else}}
{{template "empty-state" (t .Lang "no_report_data")}}
        {{end}}
      </section>
      <section class="panel">
        <h2>{{t .Lang "angsuran_report"}}</h2>
        {{if .Reports.Repayments}}
{{template "table-open" .}}
          <thead>
            <tr>
              <th>{{t $.Lang "date"}}</th>
              <th>{{t $.Lang "member"}}</th>
              <th>{{t $.Lang "member_type"}}</th>
              <th>{{t $.Lang "repayment_type"}}</th>
              <th>{{t $.Lang "amount"}}</th>
              <th>{{t $.Lang "reference"}}</th>
            </tr>
          </thead>
          <tbody>
            {{range .Reports.Repayments}}
            <tr class="{{if eq .Type "adjustment"}}historical-adjustment-row{{else if eq .Type "suspension"}}historical-suspension-row{{end}}">
              <td>{{.RecordDate}}</td>
              <td>{{template "member-table-cell" .}}</td>
              <td>{{.MemberTypeLabel}}</td>
              <td>{{t $.Lang (printf "repayment_type_%s" .Type)}}</td>
              <td>{{nominal .Amount}}</td>
              <td>{{.ReferenceNo}}</td>
            </tr>
            {{end}}
          </tbody>
{{template "table-close" .}}
        {{else}}
{{template "empty-state" (t .Lang "no_report_data")}}
        {{end}}
      </section>
{{template "admin-shell-end" .}}
{{end}}

{{define "admin-coa"}}
{{template "admin-shell-start" .}}
      {{if index .Permissions "coa.manage"}}
      <section class="panel">
        <h2>{{t .Lang "coa_import_draft"}}</h2>
        <p class="field-help">{{t .Lang "coa_import_description"}}</p>
        <form class="filter-form" method="post" action="/api/admin/coa/import" enctype="multipart/form-data">
          <label>{{t .Lang "xlsx_file"}} <input type="file" name="file" accept=".xlsx,application/vnd.openxmlformats-officedocument.spreadsheetml.sheet" required></label>
          <button type="submit">{{t .Lang "upload_coa_draft"}}</button>
        </form>
      </section>
      {{end}}
      <section class="panel">
        <h2>{{t .Lang "coa_import_batches"}}</h2>
        {{if .COABatches}}
{{template "table-open" .}}
          <thead><tr><th>{{t $.Lang "file_name"}}</th><th>{{t $.Lang "submitted_by"}}</th><th>{{t $.Lang "status"}}</th><th>{{t $.Lang "valid_rows"}}</th><th>{{t $.Lang "invalid_rows"}}</th><th>{{t $.Lang "action"}}</th></tr></thead>
          <tbody>{{range .COABatches}}<tr><td>{{.FileName}}</td><td>{{.UploadedBy}}</td><td>{{t $.Lang (printf "coa_import_status_%s" .Status)}}</td><td>{{.Valid}}</td><td>{{.Invalid}}</td><td><a class="button-link button-link-secondary" href="/admin/coa/import/{{.ID}}">{{t $.Lang "view_details"}}</a></td></tr>{{end}}</tbody>
{{template "table-close" .}}
        {{else}}{{template "empty-state" (t .Lang "no_coa_import_batches")}}{{end}}
      </section>
      <section class="panel">
        <h2>{{t .Lang "coa_management"}}</h2>
        {{if .COAAccounts}}
{{template "table-open" .}}
          <thead><tr><th>{{t $.Lang "account_code"}}</th><th>{{t $.Lang "account_name"}}</th><th>{{t $.Lang "account_type"}}</th><th>{{t $.Lang "normal_balance"}}</th><th>{{t $.Lang "status"}}</th></tr></thead>
          <tbody>{{range .COAAccounts}}<tr><td>{{.Code}}</td><td>{{.Name}}</td><td>{{t $.Lang (printf "account_type_%s" .AccountType)}}</td><td>{{.NormalBalance}}</td><td>{{if .Active}}{{t $.Lang "active"}}{{else}}{{t $.Lang "inactive"}}{{end}}</td></tr>{{end}}</tbody>
{{template "table-close" .}}
        {{else}}{{template "empty-state" (t .Lang "no_coa_accounts")}}{{end}}
      </section>
{{template "admin-shell-end" .}}
{{end}}

{{define "admin-coa-batch"}}
{{template "admin-shell-start" .}}
      <section class="page-actions"><a class="button-link button-link-secondary" href="/admin/coa">{{t .Lang "coa_management"}}</a></section>
      <section class="panel">
        <h2>{{.Batch.FileName}}</h2>
        <p>{{t .Lang "status"}}: {{t .Lang (printf "coa_import_status_%s" .Batch.Status)}}</p>
        <p>{{t .Lang "submitted_by"}}: {{.Batch.UploadedBy}} · {{.Batch.CreatedAt}}</p>
        <p>{{t .Lang "valid_rows"}}: {{.Batch.Valid}} · {{t .Lang "invalid_rows"}}: {{.Batch.Invalid}}</p>
        {{if and (index .Permissions "coa.approve") (and (eq .Batch.Status "draft") (eq .Batch.Invalid 0))}}
        <form method="post" action="/api/admin/coa/import/{{.Batch.ID}}/activate"><button type="submit">{{t .Lang "activate_coa_draft"}}</button></form>
        {{end}}
      </section>
      <section class="panel">
        <h2>{{t .Lang "coa_import_rows"}}</h2>
        {{if .Import.Rows}}
{{template "table-open" .}}
          <thead><tr><th>{{t $.Lang "excel_row"}}</th><th>{{t $.Lang "account_code"}}</th><th>{{t $.Lang "account_name"}}</th><th>{{t $.Lang "parent_account"}}</th><th>{{t $.Lang "account_type"}}</th><th>{{t $.Lang "account_subtype"}}</th><th>{{t $.Lang "normal_balance"}}</th><th>{{t $.Lang "group_account"}}</th><th>{{t $.Lang "status"}}</th><th>{{t $.Lang "error"}}</th></tr></thead>
          <tbody>{{range .Import.Rows}}<tr><td>{{.ExcelRow}}</td><td>{{.Code}}</td><td>{{.Name}}</td><td>{{.ParentCode}}</td><td>{{t $.Lang (printf "account_type_%s" .AccountType)}}</td><td>{{.Subtype}}</td><td>{{.NormalBalance}}</td><td>{{if .IsGroup}}{{t $.Lang "yes"}}{{else}}{{t $.Lang "no"}}{{end}}</td><td>{{.Status}}</td><td>{{.ErrorMessage}}</td></tr>{{end}}</tbody>
{{template "table-close" .}}
        {{else}}{{template "empty-state" (t .Lang "no_coa_import_rows")}}{{end}}
      </section>
{{template "admin-shell-end" .}}
{{end}}

{{define "admin-accounting-mappings"}}
{{template "admin-shell-start" .}}
      <section class="panel">
        <h2>{{t .Lang "accounting_mapping"}}</h2>
        <p class="field-help">{{t .Lang "accounting_mapping_description"}}</p>
        <form class="filter-form" method="post" action="/api/admin/accounting-mappings">
          <label>{{t .Lang "transaction_type"}} <input name="transaction_type" required></label>
          <label>{{t .Lang "component"}} <input name="component" required></label>
          <label>{{t .Lang "category"}} <input name="category"></label>
          <label>{{t .Lang "loan_type"}} <input name="loan_type"></label>
          <label>{{t .Lang "coa_account"}}
            <select name="coa_code" required>
              <option value="">{{t .Lang "select_coa_account"}}</option>
              {{range .COAAccounts}}<option value="{{.Code}}">{{.Code}} - {{.Name}}</option>{{end}}
            </select>
          </label>
          <label>{{t .Lang "effective_from"}} <input type="date" name="effective_from"></label>
          <label>{{t .Lang "effective_to"}} <input type="date" name="effective_to"></label>
          <label>{{t .Lang "active"}} <select name="active"><option value="true" selected>{{t .Lang "active"}}</option><option value="false">{{t .Lang "inactive"}}</option></select></label>
          <button type="submit">{{t .Lang "save_mapping"}}</button>
        </form>
      </section>
      <section class="panel">
        <h2>{{t .Lang "accounting_mappings"}}</h2>
        {{if .Mappings}}
{{template "table-open" .}}
          <thead><tr><th>{{t $.Lang "transaction_type"}}</th><th>{{t $.Lang "component"}}</th><th>{{t $.Lang "category"}}</th><th>{{t $.Lang "loan_type"}}</th><th>{{t $.Lang "coa_account"}}</th><th>{{t $.Lang "effective_from"}}</th><th>{{t $.Lang "effective_to"}}</th><th>{{t $.Lang "active"}}</th><th>{{t $.Lang "action"}}</th></tr></thead>
          <tbody>
            {{range $mapping := .Mappings}}
            <tr>
              <td><input form="mapping-{{$mapping.ID}}" name="transaction_type" value="{{$mapping.TransactionType}}" required></td>
              <td><input form="mapping-{{$mapping.ID}}" name="component" value="{{$mapping.Component}}" required></td>
              <td><input form="mapping-{{$mapping.ID}}" name="category" value="{{$mapping.Category}}"></td>
              <td><input form="mapping-{{$mapping.ID}}" name="loan_type" value="{{$mapping.LoanType}}"></td>
              <td><select form="mapping-{{$mapping.ID}}" name="coa_code" required>{{range $.COAAccounts}}<option value="{{.Code}}" {{if eq .Code $mapping.COACode}}selected{{end}}>{{.Code}} - {{.Name}}</option>{{end}}</select></td>
              <td><input form="mapping-{{$mapping.ID}}" type="date" name="effective_from" value="{{$mapping.EffectiveFrom}}"></td>
              <td><input form="mapping-{{$mapping.ID}}" type="date" name="effective_to" value="{{$mapping.EffectiveTo}}"></td>
              <td><select form="mapping-{{$mapping.ID}}" name="active"><option value="true" {{if $mapping.Active}}selected{{end}}>{{t $.Lang "active"}}</option><option value="false" {{if not $mapping.Active}}selected{{end}}>{{t $.Lang "inactive"}}</option></select></td>
              <td><form id="mapping-{{$mapping.ID}}" method="post" action="/api/admin/accounting-mappings/{{$mapping.ID}}/update"><button type="submit">{{t $.Lang "save"}}</button></form></td>
            </tr>
            {{end}}
          </tbody>
{{template "table-close" .}}
        {{else}}
{{template "empty-state" (t .Lang "no_accounting_mappings")}}
        {{end}}
      </section>
