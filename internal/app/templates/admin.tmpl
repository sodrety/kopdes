                {{else}}—{{end}}
              </td>
              {{end}}
            </tr>
            {{end}}
          </tbody>
{{template "table-close" .}}
        {{else}}
{{template "empty-state" (t .Lang "no_repayments")}}
        {{end}}
      </section>
      {{if .CanCorrect}}
      {{range .Repayments}}
      {{if eq .Type "repayment"}}
      {{template "repayment-edit-modal" (dict "Lang" $.Lang "Repayment" . "ReturnTo" "/admin/repayments")}}
      <div id="repayment-remove-{{.ID}}" class="review-modal" role="dialog" aria-modal="true" aria-labelledby="repayment-remove-title-{{.ID}}">
        <a class="review-modal-backdrop" href="#" aria-label="{{t $.Lang "close"}}"></a>
        <div class="review-modal-card">
          <header class="review-modal-header">
            <h2 id="repayment-remove-title-{{.ID}}">{{t $.Lang "remove_repayment"}}</h2>
            <a class="review-modal-close" href="#" aria-label="{{t $.Lang "close"}}">×</a>
          </header>
          <p>{{.FullName}} · {{.MemberNo}} · {{.RecordDate}} · Rp {{nominal .Amount}}</p>
          <p>{{t $.Lang "confirm_remove_repayment"}}</p>
          <form method="post" action="/api/admin/repayments/{{.ID}}/remove">
            <label>{{t $.Lang "correction_reason"}} <input name="reason" maxlength="500" required></label>
            <div class="button-row">
              <button type="submit">{{t $.Lang "remove_repayment"}}</button>
              <a class="button-link button-link-secondary" href="#">{{t $.Lang "cancel"}}</a>
            </div>
          </form>
        </div>
      </div>
      {{end}}
      {{end}}
      {{end}}
      <section class="panel">
        <h2>{{t .Lang "repayment_audit_history"}}</h2>
        {{if .RepaymentAudits}}
{{template "table-open" .}}
          <thead>
            <tr>
              <th>{{t $.Lang "date"}}</th>
              <th>{{t $.Lang "member"}}</th>
              <th>{{t $.Lang "repayment_audit_action"}}</th>
              <th>{{t $.Lang "audit_reason"}}</th>
              <th>{{t $.Lang "changes"}}</th>
            </tr>
          </thead>
          <tbody>
            {{range .RepaymentAudits}}
            <tr>
              <td>{{.CreatedAt}}</td>
              <td>{{template "member-table-cell" .}}<small>{{.RepaymentID}}</small></td>
              <td>{{t $.Lang (printf "repayment_audit_action_%s" .Action)}}</td>
              <td>{{.Reason}}<small>{{t $.Lang "audit_actor"}}: {{.ActorName}}</small></td>
              <td>
                <details>
                  <summary>{{t $.Lang "view_change"}}</summary>
                  <p><strong>{{t $.Lang "before"}}</strong>: {{if eq .Action "added"}}—{{else}}{{nominal .Before.Amount}} · {{.Before.RecordDate}} · {{.Before.ReferenceNo}} · {{.Before.Note}}{{end}}</p>
                  <p><strong>{{t $.Lang "after"}}</strong>: {{if .HasAfter}}{{nominal .After.Amount}} · {{.After.RecordDate}} · {{.After.ReferenceNo}} · {{.After.Note}}{{else}}—{{end}}</p>
                </details>
              </td>
            </tr>
            {{end}}
          </tbody>
{{template "table-close" .}}
        {{else}}
{{template "empty-state" (t .Lang "no_repayment_audits")}}
        {{end}}
      </section>
{{template "admin-shell-end" .}}
{{end}}

{{define "repayment-edit-modal"}}
{{$lang := .Lang}}
{{$returnTo := .ReturnTo}}
{{with .Repayment}}
      <div id="repayment-edit-{{.ID}}" class="review-modal" role="dialog" aria-modal="true" aria-labelledby="repayment-edit-title-{{.ID}}">
        <a class="review-modal-backdrop" href="#" aria-label="{{t $lang "close"}}"></a>
        <div class="review-modal-card">
          <header class="review-modal-header">
            <h2 id="repayment-edit-title-{{.ID}}">{{t $lang "edit_repayment"}}</h2>
            <a class="review-modal-close" href="#" aria-label="{{t $lang "close"}}">×</a>
          </header>
          <p>{{.RecordDate}} · Rp {{nominal .Amount}}</p>
          <form method="post" action="/api/admin/repayments/{{.ID}}/update">
            <input type="hidden" name="return_to" value="{{$returnTo}}">
            <label>{{t $lang "amount"}} <input name="amount" type="text" inputmode="numeric" value="{{nominal .Amount}}" data-rupiah-input data-rupiah-group="{{if eq $lang "id"}}.{{else}},{{end}}" data-rupiah-invalid="{{t $lang "error_invalid_rupiah_amount"}}" required></label>
            <label>{{t $lang "date"}} <input name="record_date" type="date" value="{{.RecordDate}}" required></label>
            <label>{{t $lang "reference"}} <input name="reference_no" value="{{.ReferenceNo}}"></label>
            <label>{{t $lang "note"}} <input name="note" value="{{.Note}}"></label>
            <label>{{t $lang "correction_reason"}} <input name="reason" maxlength="500" required></label>
            <div class="button-row">
              <button type="submit">{{t $lang "save_repayment_changes"}}</button>
              <a class="button-link button-link-secondary" href="#">{{t $lang "cancel"}}</a>
            </div>
          </form>
        </div>
      </div>
{{end}}
{{end}}
