      {{else if eq .View "ledger"}}
      <section class="panel">
        <h2>{{t .Lang "general_ledger"}}</h2>
        <form class="filter-form" method="get" action="/admin/journals"><input type="hidden" name="view" value="ledger">
          <label>{{t .Lang "coa_account"}} <select name="account"><option value="">{{t .Lang "select_coa_account"}}</option>{{range .COAAccounts}}<option value="{{.Code}}" {{if eq $.SelectedAccount .Code}}selected{{end}}>{{.Code}} - {{.Name}}</option>{{end}}</select></label>
          <label>{{t .Lang "date_from"}} <input name="date_from" type="date" value="{{.DateFrom}}"></label><label>{{t .Lang "date_to"}} <input name="date_to" type="date" value="{{.DateTo}}"></label><button type="submit">{{t .Lang "apply_filters"}}</button>
