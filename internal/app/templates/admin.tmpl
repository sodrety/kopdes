                  <a class="button-link button-link-secondary" href="#repayment-edit-{{.ID}}">{{t $.Lang "edit_repayment"}}</a>
                  <a class="button-link button-link-secondary" href="#repayment-remove-{{.ID}}">{{t $.Lang "remove_repayment"}}</a>
