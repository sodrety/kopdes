              <td>{{.Purpose}}</td>
              <td>{{.RejectionReason}}</td>
            </tr>
            {{end}}
          </tbody>
{{template "table-close" .}}
        {{else}}
{{template "empty-state" (t .Lang "no_loan_requests")}}
        {{end}}
      </section>
      <section class="panel">
        <h2>{{t .Lang "outstanding_loans"}}</h2>
        {{if .OutstandingLoans}}
        {{range .OutstandingLoans}}
        {{if eq .Status "active"}}<p>{{t $.Lang "active_loan"}}</p>{{end}}
        <div class="detail-grid">
          <div><span>{{t $.Lang "loan_type"}}</span><strong>{{template "loan-type-label" (dict "Lang" $.Lang "LoanType" .LoanType "LegacyTerms" .LegacyTerms)}}</strong></div>
          <div><span>{{t $.Lang "approved_amount"}}</span><strong>{{nominal .ApprovedAmount}}</strong></div>
          <div><span>{{t $.Lang "remaining_balance"}}</span><strong>{{nominal .RemainingBalance}}</strong></div>
          <div><span>{{t $.Lang "next_due_date"}}</span><strong>{{.NextDueDate}}</strong></div>
          <div><span>{{t $.Lang "final_due_date"}}</span><strong>{{.FinalDueDate}}</strong></div>
          <div><span>{{t $.Lang "status"}}</span><strong>{{t $.Lang (printf "status_%s" .Status)}}</strong></div>
        </div>
        {{end}}
        {{else}}
{{template "empty-state" (t .Lang "no_active_loan")}}
        {{end}}
      </section>
      <section class="panel">
        <h2>{{t .Lang "repayment_records"}}</h2>
        {{if .Repayments}}
{{template "table-open" .}}
          <thead>
            <tr>
              <th>{{t $.Lang "date"}}</th>
              <th>{{t $.Lang "repayment_type"}}</th>
              <th>{{t $.Lang "amount"}}</th>
              <th>{{t $.Lang "reference"}}</th>
              <th>{{t $.Lang "note"}}</th>
            </tr>
          </thead>
          <tbody>
            {{range .Repayments}}
            <tr class="{{if eq .Type "adjustment"}}historical-adjustment-row{{else if eq .Type "suspension"}}historical-suspension-row{{end}}">
              <td>{{.RecordDate}}</td>
              <td>{{t $.Lang (printf "repayment_type_%s" .Type)}}</td>
              <td>{{nominal .Amount}}</td>
              <td>{{.ReferenceNo}}</td>
              <td>{{.Note}}</td>
            </tr>
            {{end}}
          </tbody>
{{template "table-close" .}}
        {{else}}
{{template "empty-state" (t .Lang "no_repayment_records")}}
        {{end}}
      </section>
{{template "admin-shell-end" .}}
{{end}}

{{define "admin-loan-detail"}}
{{template "admin-shell-start" .}}
      <section class="page-actions">
        {{if index .Permissions "reports.view"}}<a class="button-link button-link-secondary" href="/api/admin/loans/{{.Loan.ID}}/export.pdf">{{t .Lang "export_pdf"}}</a>{{end}}
        {{if index .Permissions "loan_reports.generate"}}
        <a class="button-link button-link-secondary" href="/api/admin/loans/{{.Loan.ID}}/reports/application.pdf">{{t .Lang "loan_application_pdf"}}</a>
        <a class="button-link button-link-secondary" href="/api/admin/loans/{{.Loan.ID}}/reports/acceptance.pdf">{{t .Lang "loan_acceptance_pdf"}}</a>
        {{end}}
      </section>
      <section class="panel {{if .Loan.IsOverdue}}loan-warning{{end}}">
        <h2>{{t .Lang "loan_detail"}}</h2>
        <div class="detail-grid">
          <div><span>{{t .Lang "loan_type"}}</span><strong>{{template "loan-type-label" (dict "Lang" .Lang "LoanType" .Loan.LoanType "LegacyTerms" .Loan.LegacyTerms)}}</strong></div>
          <div><span>{{t .Lang "approved_principal"}}</span><strong>Rp {{nominal .Loan.ApprovedAmount}}</strong></div>
		  <div><span>{{t .Lang "monthly_admin_fee"}}</span><strong>Rp {{nominal .Loan.MonthlyAdminFee}}</strong></div>
		  <div><span>{{t .Lang "total_admin_fee"}}</span><strong>Rp {{nominal .Loan.TotalAdminFee}}</strong></div>
          <div><span>{{t .Lang "total_obligation"}}</span><strong>Rp {{nominal .Loan.TotalObligation}}</strong></div>
          <div><span>{{t .Lang "remaining_balance"}}</span><strong>Rp {{nominal .Loan.RemainingBalance}}</strong></div>
          <div><span>{{t .Lang "start_date"}}</span><strong>{{.Loan.StartDate}}</strong></div>
          <div><span>{{t .Lang "next_due_date"}}</span><strong>{{.Loan.NextDueDate}}</strong></div>
          <div><span>{{t .Lang "final_due_date"}}</span><strong>{{.Loan.FinalDueDate}}</strong></div>
          <div><span>{{t .Lang "status"}}</span><strong>{{t .Lang (printf "status_%s" .Loan.Status)}}</strong></div>
        </div>
        {{if .Loan.IsOverdue}}<p class="overdue-label">{{t .Lang "overdue"}}</p>{{end}}
