{{define "admin-dashboard"}}
{{template "admin-shell-start" .}}
      <section class="summary-grid">
{{template "summary-card" (dict "Label" (t .Lang "total_members") "Value" .Summary.TotalMembers "Icon" "users")}}
{{template "summary-card" (dict "Label" (t .Lang "active_members") "Value" .Summary.ActiveMembers "Icon" "user-check")}}
{{template "summary-card" (dict "Label" (t .Lang "total_savings") "Value" (nominal .Summary.TotalSavings) "Icon" "piggy-bank")}}
{{template "summary-card" (dict "Label" (t .Lang "active_loans") "Value" .Summary.ActiveLoans "Icon" "landmark")}}
{{template "summary-card" (dict "Label" (t .Lang "outstanding_loan") "Value" (nominal .Summary.TotalOutstandingLoan) "Icon" "banknote")}}
{{template "summary-card" (dict "Label" (t .Lang "pending_requests") "Value" .Summary.PendingLoanRequests "Icon" "file-clock")}}
      </section>
      <section class="dashboard-line-grid">
{{template "line-chart" (dict "Lang" .Lang "Chart" .Reports.SavingsLoanComparison "Size" "line-chart-wide")}}
{{template "line-chart" (dict "Lang" .Lang "Chart" .Reports.BalanceTrend "Size" "line-chart-compact")}}
      </section>
      <section class="dashboard-home-grid">
        <article class="panel dashboard-activity-card">
          <header class="panel-header">
            <h2>{{t .Lang "recent_activity"}}</h2>
          </header>
          {{if .Reports.Repayments}}
{{template "table-open" .}}
            <thead>
              <tr>
                <th>{{t $.Lang "date"}}</th>
                <th>{{t $.Lang "category"}}</th>
                <th>{{t $.Lang "description"}}</th>
                <th>{{t $.Lang "amount"}}</th>
              </tr>
            </thead>
            <tbody>
              {{range .Reports.Repayments}}
              <tr>
                <td>{{.RecordDate}}</td>
                <td>{{t $.Lang (printf "repayment_type_%s" .Type)}}</td>
                <td>{{.FullName}} - {{.ReferenceNo}}</td>
                <td>{{nominal .Amount}}</td>
              </tr>
              {{end}}
            </tbody>
{{template "table-close" .}}
          {{else if .Reports.Loans}}
{{template "table-open" .}}
            <thead>
              <tr>
                <th>{{t $.Lang "date"}}</th>
                <th>{{t $.Lang "category"}}</th>
                <th>{{t $.Lang "description"}}</th>
                <th>{{t $.Lang "amount"}}</th>
              </tr>
            </thead>
            <tbody>
              {{range .Reports.Loans}}
              <tr>
                <td>{{.CreatedAt}}</td>
                <td>{{t $.Lang "pinjaman"}}</td>
                <td>{{.FullName}}</td>
                <td>{{nominal .ApprovedAmount}}</td>
              </tr>
              {{end}}
            </tbody>
{{template "table-close" .}}
          {{else}}
{{template "empty-state" (t .Lang "no_report_data")}}
          {{end}}
        </article>
        <article class="panel dashboard-quick-card">
          <header class="panel-header">
            <h2>{{t .Lang "quick_actions"}}</h2>
          </header>
          <div class="dashboard-quick-list">
            <a href="/admin/members/new"><i data-lucide="user-plus"></i><span>{{t .Lang "create_member"}}</span></a>
            <a href="/admin/savings/new"><i data-lucide="piggy-bank"></i><span>{{t .Lang "record_saving"}}</span></a>
            <a href="/admin/loan-requests"><i data-lucide="file-clock"></i><span>{{t .Lang "loan_requests"}}</span></a>
            <a href="/admin/reports/balance"><i data-lucide="scale"></i><span>{{t .Lang "balance_report"}}</span></a>
          </div>
        </article>
      </section>
{{template "admin-shell-end" .}}
{{end}}

{{define "admin-loan-request-batch"}}
{{template "admin-shell-start" .}}
      <section class="page-actions">
        <a class="button-link button-link-secondary" href="/api/admin/loan-request-batches/{{.Batch.ID}}/export.xlsx">{{t .Lang "admin_loan_batch_export"}}</a>
        <a class="button-link button-link-secondary" href="/admin/loan-requests?batch_id={{.Batch.ID}}">{{t .Lang "loan_requests"}}</a>
      </section>
      <section class="panel">
        <h2>{{t .Lang "admin_loan_batch_heading"}}</h2>
        <p class="field-help">{{t .Lang "admin_loan_batch_description"}}</p>
        <div class="detail-grid">
          <div><span>{{t .Lang "admin_loan_batch_id"}}</span><strong>{{.Batch.ID}}</strong></div>
          <div><span>{{t .Lang "admin_loan_creator"}}</span><strong>{{.Batch.CreatedByName}}</strong></div>
          <div><span>{{t .Lang "created"}}</span><strong>{{.Batch.CreatedAt}}</strong></div>
          <div><span>{{t .Lang "admin_loan_batch_status"}}</span><strong>{{t .Lang (printf "admin_loan_batch_status_%s" .Batch.Status)}}</strong></div>
          <div><span>{{t .Lang "admin_loan_batch_rows"}}</span><strong>{{.Batch.RowCount}}</strong></div>
          <div><span>{{t .Lang "created"}}</span><strong>{{.Batch.CreatedCount}}</strong></div>
          <div><span>{{t .Lang "error"}}</span><strong>{{.Batch.ErrorCount}}</strong></div>
          <div><span>{{t .Lang "warning"}}</span><strong>{{.Batch.WarningCount}}</strong></div>
          <div><span>{{t .Lang "pending"}}</span><strong>{{.Batch.PendingCount}}</strong></div>
          <div><span>{{t .Lang "approved"}}</span><strong>{{.Batch.ApprovedCount}}</strong></div>
          <div><span>{{t .Lang "rejected"}}</span><strong>{{.Batch.RejectedCount}}</strong></div>
          <div><span>{{t .Lang "status_cancelled"}}</span><strong>{{.Batch.CancelledCount}}</strong></div>
        </div>
        {{if .Batch.BatchWarnings}}
        <div class="notice notice-warning"><strong>{{t .Lang "warning"}}</strong><ul>{{range .Batch.BatchWarnings}}<li>{{t $.Lang .}}</li>{{end}}</ul></div>
        {{end}}
        {{if .Batch.CanConfirm}}
        <form method="post" action="/api/admin/loan-requests/bulk/{{.Batch.ID}}/commit" hx-post="/api/admin/loan-requests/bulk/{{.Batch.ID}}/commit" hx-target="#admin-loan-batch-error" hx-swap="innerHTML">
          <p class="field-help">{{t .Lang "admin_loan_batch_confirm_help"}}</p>
          <label class="remember-field"><input name="acknowledge_warnings" type="checkbox" {{if .Batch.WarningCount}}required{{end}}> {{t .Lang "acknowledge_admin_loan_warnings"}}</label>
          <button type="submit">{{t .Lang "admin_loan_batch_commit"}}</button>
        </form>
        {{end}}
        {{template "form-error" (dict "ID" "admin-loan-batch-error")}}
      </section>
      <section class="panel">
        <h2>{{t .Lang "admin_loan_batch_rows"}}</h2>
        {{if .Batch.Rows}}
{{template "table-open" .}}
          <thead><tr><th>#</th><th>{{t .Lang "member_no"}}</th><th>{{t .Lang "name"}}</th><th>{{t .Lang "loan_type"}}</th><th>{{t .Lang "amount"}}</th><th>{{t .Lang "duration"}}</th><th>{{t .Lang "purpose"}}</th><th>{{t .Lang "status"}}</th><th>{{t .Lang "error"}}</th><th>{{t .Lang "warning"}}</th><th>{{t .Lang "loan_id"}}</th></tr></thead>
          <tbody>
            {{range .Batch.Rows}}
            <tr>
              <td>{{.ExcelRow}}</td><td>{{.MemberNo}}</td><td>{{.FullName}}</td><td>{{template "loan-type-label" (dict "Lang" $.Lang "LoanType" .LoanType "LegacyTerms" false)}}</td><td>{{if .RequestedAmount}}{{nominal .RequestedAmount}}{{else}}{{t $.Lang "none"}}{{end}}</td><td>{{if .DurationMonths}}{{.DurationMonths}} {{t $.Lang "months"}}{{else}}{{t $.Lang "none"}}{{end}}</td><td>{{.Purpose}}</td><td>{{t $.Lang (printf "admin_loan_row_status_%s" .Status)}}</td>
              <td>{{range .Errors}}<div>{{t $.Lang .}}</div>{{end}}</td><td>{{range .Warnings}}<div>{{t $.Lang .}}</div>{{end}}</td><td>{{if .RequestID}}<a href="/admin/loan-requests?status=pending&batch_id={{$.Batch.ID}}">{{.RequestID}}</a>{{else}}{{t $.Lang "none"}}{{end}}</td>
            </tr>
            {{end}}
          </tbody>
{{template "table-close" .}}
        {{else}}
        <p>{{t .Lang "admin_issue_invalid_template"}}</p>
        {{end}}
      </section>
{{template "admin-shell-end" .}}
{{end}}

{{define "admin-reports"}}
{{template "admin-shell-start" .}}
      <section class="page-actions">
        <a class="button-link button-link-secondary" href="/admin/reports/balance">{{t .Lang "balance_report"}}</a>
      </section>
      <section class="chart-grid">
        <article class="panel chart-panel">
          <h2>{{t .Lang "simpanan_by_category"}}</h2>
{{template "bar-chart" (dict "Lang" .Lang "TitleKey" "simpanan_by_category" "Format" "currency" "Segments" .Reports.SavingsByCategory)}}
        </article>
        <article class="panel chart-panel">
          <h2>{{t .Lang "penarikan_by_status"}}</h2>
{{template "bar-chart" (dict "Lang" .Lang "TitleKey" "penarikan_by_status" "Format" "count" "Segments" .Reports.WithdrawalsByStatus)}}
        </article>
        <article class="panel chart-panel">
          <h2>{{t .Lang "pinjaman_exposure"}}</h2>
{{template "bar-chart" (dict "Lang" .Lang "TitleKey" "pinjaman_exposure" "Format" "currency" "Segments" .Reports.LoanExposure)}}
        </article>
        <article class="panel chart-panel">
          <h2>{{t .Lang "angsuran_progress"}}</h2>
{{template "bar-chart" (dict "Lang" .Lang "TitleKey" "angsuran_progress" "Format" "currency" "Segments" .Reports.RepaymentProgress)}}
        </article>
