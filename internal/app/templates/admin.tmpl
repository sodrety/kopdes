        {{if .LoanRequests}}
{{template "table-open" .}}
          <thead>
            <tr>
              <th>{{t $.Lang "amount"}}</th>
              <th>{{t $.Lang "loan_type"}}</th>
              <th>{{t $.Lang "duration"}}</th>
              <th>{{t $.Lang "status"}}</th>
              <th>{{t $.Lang "purpose"}}</th>
              <th>{{t $.Lang "rejection_reason"}}</th>
            </tr>
          </thead>
          <tbody>
            {{range .LoanRequests}}
