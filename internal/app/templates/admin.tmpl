        <form class="filter-form" method="post" action="/api/admin/transaction-categories/import" enctype="multipart/form-data" hx-post="/api/admin/transaction-categories/import" hx-target="#cash-category-import-error" hx-swap="innerHTML">
          <label>{{t .Lang "xlsx_file"}}
            <input type="file" name="file" accept=".xlsx,application/vnd.openxmlformats-officedocument.spreadsheetml.sheet" required>
          </label>
          <button type="submit">{{t .Lang "import_category_template"}}</button>
        </form>
        {{template "form-error" (dict "ID" "cash-category-import-error")}}
      </section>
      <section class="content-grid content-grid-two">
        <article class="panel form-panel">
          <h2>{{t .Lang "add_cash_transaction_category"}}</h2>
          <form method="post" action="/api/admin/transaction-categories" hx-post="/api/admin/transaction-categories" hx-target="#cash-category-error" hx-swap="innerHTML">
            <label>{{t .Lang "direction"}}
              <select name="direction" data-cash-category-direction required>
                <option value="">{{t .Lang "select_direction"}}</option>
                <option value="cash_in">{{t .Lang "cash_in"}}</option>
                <option value="cash_out">{{t .Lang "cash_out"}}</option>
              </select>
            </label>
            <label>{{t .Lang "account_code"}} <span class="field-help">({{t .Lang "optional"}})</span><input name="account_code" maxlength="50"></label>
            <label>{{t .Lang "category_name"}} <input name="name" maxlength="100" required></label>
            <label>{{t .Lang "parent_category"}} <span class="field-help">({{t .Lang "optional"}})</span>
              <select name="parent_id" data-cash-category-parent>
                <option value="">{{t .Lang "root_category"}}</option>
                {{range .Categories}}{{if .Active}}<option value="{{.ID}}" data-direction="{{.Direction}}">{{.DisplayName}}</option>{{end}}{{end}}
              </select>
            </label>
            <label>{{t .Lang "normal_balance"}} <span class="field-help">({{t .Lang "optional"}})</span>
              <select name="normal_balance"><option value="">—</option><option value="D">D</option><option value="C">C</option></select>
            </label>
            <button type="submit">{{t .Lang "add_cash_transaction_category"}}</button>
          </form>
          {{template "form-error" (dict "ID" "cash-category-error")}}
        </article>
        <article class="panel">
          <div class="section-heading-row"><h2>{{t .Lang "cash_transaction_category"}}</h2><span class="field-help">{{t .Lang "category_tree"}}</span></div>
          {{if .Categories}}
{{template "table-open" .}}
            <thead><tr><th>{{t $.Lang "direction"}}</th><th>{{t $.Lang "account_code"}}</th><th>{{t $.Lang "category_name"}}</th><th>{{t $.Lang "parent_category"}}</th><th>{{t $.Lang "normal_balance"}}</th><th>{{t $.Lang "status"}}</th><th>{{t $.Lang "action"}}</th></tr></thead>
            <tbody>
              {{range .Categories}}
              <tr>
                <td>{{t $.Lang .Direction}}</td>
                <td>{{if .AccountCode}}{{.AccountCode}}{{else}}-{{end}}</td>
                <td>
                    <div class="category-tree-label">{{.DisplayName}}</div>
                    <input name="name" form="cash-category-form-{{.ID}}" value="{{.Name}}" maxlength="100" required>
                    {{if or .IsGroup .HasChildren}}<small class="field-help">{{t $.Lang "group_category"}}</small>{{end}}
                </td>
                <td>{{if .ParentName}}{{.ParentName}}{{else}}-{{end}}</td>
                <td>{{if .NormalBalance}}{{.NormalBalance}}{{else}}-{{end}}</td>
                <td>
                    <select name="active" form="cash-category-form-{{.ID}}"><option value="true" {{if .Active}}selected{{end}}>{{t $.Lang "active"}}</option><option value="false" {{if not .Active}}selected{{end}}>{{t $.Lang "inactive"}}</option></select>
                </td>
                <td><form id="cash-category-form-{{.ID}}" method="post" action="/api/admin/transaction-categories/{{.ID}}/update" hx-post="/api/admin/transaction-categories/{{.ID}}/update" hx-target="#cash-category-error-{{.ID}}" hx-swap="innerHTML"><input type="hidden" name="account_code" value="{{.AccountCode}}"><input type="hidden" name="parent_id" value="{{.ParentID}}"><input type="hidden" name="normal_balance" value="{{.NormalBalance}}"><button class="button-secondary" type="submit">{{t $.Lang "save"}}</button></form><p id="cash-category-error-{{.ID}}" class="form-error"></p></td>
              </tr>
              {{end}}
            </tbody>
{{template "table-close" .}}
          {{else}}
{{template "empty-state" (t .Lang "no_cash_transaction_categories")}}
          {{end}}
        </article>
      </section>
      <script>
        document.addEventListener("DOMContentLoaded", function () {
          var direction = document.querySelector("[data-cash-category-direction]");
          var parent = document.querySelector("[data-cash-category-parent]");
          if (!direction || !parent) return;
          function filterParents() {
            Array.prototype.forEach.call(parent.options, function (option) {
              if (!option.dataset.direction) return;
              option.hidden = direction.value !== "" && option.dataset.direction !== direction.value;
            });
            if (parent.selectedOptions.length && parent.selectedOptions[0].hidden) parent.value = "";
          }
          direction.addEventListener("change", filterParents);
          filterParents();
        });
      </script>
{{template "admin-shell-end" .}}
{{end}}

