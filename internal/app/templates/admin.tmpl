                  <a class="review-modal-backdrop" href="#" aria-label="{{t $.Lang "close"}}"></a>
                  <div class="review-modal-card">
                    <header class="review-modal-header">
                      <h2 id="loan-request-review-title-{{.ID}}">{{t $.Lang "loan_request_review"}}</h2>
                      <a class="review-modal-close" href="#" aria-label="{{t $.Lang "close"}}">×</a>
                    </header>
                    <div class="detail-grid review-detail-grid">
                      <div><span>{{t $.Lang "member"}}</span><strong>{{.FullName}} · {{.MemberNo}}</strong></div>
                      <div><span>{{t $.Lang "loan_type"}}</span><strong>{{template "loan-type-label" (dict "Lang" $.Lang "LoanType" .LoanType "LegacyTerms" .LegacyTerms)}}</strong></div>
                      <div><span>{{t $.Lang "amount"}}</span><strong>Rp {{nominal .RequestedAmount}}</strong></div>
                      <div><span>{{t $.Lang "duration"}}</span><strong>{{.DurationMonths}} {{t $.Lang "months"}}</strong></div>
                      <div><span>{{t $.Lang "purpose"}}</span><strong>{{.Purpose}}</strong></div>
                      <div><span>{{t $.Lang "status"}}</span><strong>{{t $.Lang (printf "status_%s" .Status)}}{{if .CurrentApprovalStage}} · {{t $.Lang "awaiting"}} {{t $.Lang (printf "role_%s" .CurrentApprovalStage)}}{{end}}</strong></div>
                      <div><span>{{t $.Lang "admin_loan_provenance"}}</span><strong>{{t $.Lang (printf "admin_loan_source_%s" .CreationSource)}} · {{if .CreatedByName}}{{.CreatedByName}}{{else}}{{t $.Lang "admin_loan_source_member"}}{{end}}{{if .BatchID}} · <a href="/admin/loan-request-batches/{{.BatchID}}">{{.BatchID}}</a>{{end}}</strong></div>
                    </div>
                    {{if and (eq $.Role "super_admin") (index $.Permissions "requests.override") (eq .Status "pending")}}
                    <div class="review-modal-actions">
                      <p><strong>{{t $.Lang "super_admin_override"}}</strong> — {{t $.Lang "super_admin_override_help"}}</p>
                      <form class="inline-approval-form review-action" method="post" action="/api/admin/loan-requests/{{.ID}}/override-approve" hx-post="/api/admin/loan-requests/{{.ID}}/override-approve" hx-target="#loan-review-error" hx-swap="innerHTML" data-loan-fee-preview data-loan-type-value="{{.LoanType}}" data-monthly-admin-fee-label="{{t $.Lang "monthly_admin_fee"}}" data-total-admin-fee-label="{{t $.Lang "total_admin_fee"}}" data-total-obligation-label="{{t $.Lang "total_obligation"}}" data-rupiah-group="{{if eq $.Lang "id"}}.{{else}},{{end}}">
                        {{if index $.Permissions "accounting_coa.override"}}
                        <label>{{t $.Lang "cash_bank_account"}} <select name="cash_coa_code"><option value="">{{t $.Lang "use_mapping"}}</option>{{range $.COAAccounts}}<option value="{{.Code}}" {{if eq .Code $.ProposedCashCOACode}}selected{{end}}>{{.Code}} - {{.Name}}</option>{{end}}</select></label>
                        <label>{{t $.Lang "loan_receivable_account"}} <select name="coa_code"><option value="">{{t $.Lang "use_mapping"}}</option>{{range $.COAAccounts}}<option value="{{.Code}}" {{if eq .Code $.ProposedLoanCOACode}}selected{{end}}>{{.Code}} - {{.Name}}</option>{{end}}</select></label>
                        <label>{{t $.Lang "admin_fee_income_account"}} <select name="admin_fee_coa_code"><option value="">{{t $.Lang "use_mapping"}}</option>{{range $.COAAccounts}}<option value="{{.Code}}" {{if eq .Code $.ProposedAdminFeeCOACode}}selected{{end}}>{{.Code}} - {{.Name}}</option>{{end}}</select></label>
                        {{end}}
                        <label>{{t $.Lang "approved_amount"}}
                          <input name="approved_amount" type="text" inputmode="numeric" value="{{if gt .ProposedApprovedAmount 0}}{{.ProposedApprovedAmount}}{{else}}{{.RequestedAmount}}{{end}}" data-rupiah-input data-loan-amount data-rupiah-group="{{if eq $.Lang "id"}}.{{else}},{{end}}" data-rupiah-invalid="{{t $.Lang "error_invalid_rupiah_amount"}}" data-rupiah-max="{{.MaxLoanAmount}}" data-rupiah-max-invalid="{{t $.Lang "error_loan_amount_limit"}}" autocomplete="off" spellcheck="false" required>
                        </label>
                        <label>{{t $.Lang "duration"}} <input name="duration_months" type="number" min="1" max="{{if eq .LoanType "goods_purchase_paylater"}}1{{else if eq .LoanType "secondary_goods"}}12{{else}}24{{end}}" value="{{if gt .ProposedDurationMonths 0}}{{.ProposedDurationMonths}}{{else}}{{.DurationMonths}}{{end}}" data-loan-duration aria-label="{{t $.Lang "duration_months"}}" required></label>
                        <label>{{t $.Lang "start_date"}} <input name="start_date" type="date" value="{{if .ProposedStartDate}}{{.ProposedStartDate}}{{else}}{{$.CurrentDate}}{{end}}" required aria-label="{{t $.Lang "start_date"}}"></label>
                        <p class="loan-fee-preview" data-loan-fee-output aria-live="polite" hidden></p>
                        <label>{{t $.Lang "approval_note_optional"}} <input name="note" aria-label="{{t $.Lang "approval_note_optional"}}"></label>
                        <div class="table-actions"><button type="submit">{{t $.Lang "super_admin_approve"}}</button></div>
                      </form>
                      <form class="inline-rejection-form review-action" method="post" action="/api/admin/loan-requests/{{.ID}}/override-reject" hx-post="/api/admin/loan-requests/{{.ID}}/override-reject" hx-target="#loan-review-error" hx-swap="innerHTML">
                        <label>{{t $.Lang "rejection_reason"}} <input name="rejection_reason" aria-label="{{t $.Lang "rejection_reason"}}" placeholder="{{t $.Lang "rejection_reason"}}"></label>
                        <button class="button-secondary" type="submit">{{t $.Lang "super_admin_reject"}}</button>
                      </form>
                    </div>
                    {{else if and (eq .CurrentApprovalStage "manager") (or (eq $.Role "manager") (eq $.Role "admin")) (index $.Permissions "requests.decide")}}
                    <div class="review-modal-actions">
                      <form class="inline-approval-form review-action" method="post" action="/api/admin/loan-requests/{{.ID}}/approve" hx-post="/api/admin/loan-requests/{{.ID}}/approve" hx-target="#loan-review-error" hx-swap="innerHTML" data-loan-fee-preview data-loan-type-value="{{.LoanType}}" data-monthly-admin-fee-label="{{t $.Lang "monthly_admin_fee"}}" data-total-admin-fee-label="{{t $.Lang "total_admin_fee"}}" data-total-obligation-label="{{t $.Lang "total_obligation"}}" data-rupiah-group="{{if eq $.Lang "id"}}.{{else}},{{end}}">
                        {{if index $.Permissions "accounting_coa.override"}}
                        <label>{{t $.Lang "cash_bank_account"}} <select name="cash_coa_code"><option value="">{{t $.Lang "use_mapping"}}</option>{{range $.COAAccounts}}<option value="{{.Code}}">{{.Code}} - {{.Name}}</option>{{end}}</select></label>
                        <label>{{t $.Lang "loan_receivable_account"}} <select name="coa_code"><option value="">{{t $.Lang "use_mapping"}}</option>{{range $.COAAccounts}}<option value="{{.Code}}">{{.Code}} - {{.Name}}</option>{{end}}</select></label>
                        <label>{{t $.Lang "admin_fee_income_account"}} <select name="admin_fee_coa_code"><option value="">{{t $.Lang "use_mapping"}}</option>{{range $.COAAccounts}}<option value="{{.Code}}">{{.Code}} - {{.Name}}</option>{{end}}</select></label>
                        {{end}}
                        {{if or (eq $.Role "manager") (eq $.Role "admin")}}
                        <label>{{t $.Lang "approved_amount"}}
                          <input name="approved_amount" type="text" inputmode="numeric" value="{{.RequestedAmount}}" data-rupiah-input data-loan-amount data-rupiah-group="{{if eq $.Lang "id"}}.{{else}},{{end}}" data-rupiah-invalid="{{t $.Lang "error_invalid_rupiah_amount"}}" data-rupiah-max="{{.MaxLoanAmount}}" data-rupiah-max-invalid="{{t $.Lang "error_loan_amount_limit"}}" aria-describedby="approved-amount-hint-{{.ID}}" aria-errormessage="approved-amount-error-{{.ID}}" autocomplete="off" spellcheck="false" required>
                          <small id="approved-amount-hint-{{.ID}}">{{t $.Lang "loan_amount_limit_hint"}}</small>
                          <small id="approved-amount-error-{{.ID}}" class="form-error-message" aria-live="polite" hidden></small>
                        </label>
                        <label>{{t $.Lang "duration"}} <input name="duration_months" type="number" min="1" max="{{if eq .LoanType "goods_purchase_paylater"}}1{{else if eq .LoanType "secondary_goods"}}12{{else}}24{{end}}" value="{{.DurationMonths}}" data-loan-duration aria-label="{{t $.Lang "duration_months"}}"></label>
                        <label>{{t $.Lang "start_date"}} <input name="start_date" type="date" required aria-label="{{t $.Lang "start_date"}}"></label>
                        <p class="loan-fee-preview" data-loan-fee-output aria-live="polite" hidden></p>
                        {{else}}
                        <p>{{t $.Lang "locked_terms"}}: Rp {{nominal .ProposedApprovedAmount}} · {{.ProposedDurationMonths}} {{t $.Lang "months"}} · {{.ProposedStartDate}} · {{t $.Lang "monthly_admin_fee"}} Rp {{nominal .ProposedMonthlyAdminFee}} · {{t $.Lang "total_admin_fee"}} Rp {{nominal .ProposedTotalAdminFee}} · {{t $.Lang "total_obligation"}} Rp {{nominal .ProposedTotalObligation}}</p>
                        {{end}}
                        <label>{{t $.Lang "approval_note_optional"}} <input name="note" aria-label="{{t $.Lang "approval_note_optional"}}"></label>
                        <div class="table-actions">
                          <button type="submit">{{t $.Lang "approve"}}</button>
                        </div>
                      </form>
                      <form class="inline-rejection-form review-action" method="post" action="/api/admin/loan-requests/{{.ID}}/reject" hx-post="/api/admin/loan-requests/{{.ID}}/reject" hx-target="#loan-review-error" hx-swap="innerHTML">
                        <label>{{t $.Lang "rejection_reason"}} <input name="rejection_reason" aria-label="{{t $.Lang "rejection_reason"}}" placeholder="{{t $.Lang "rejection_reason"}}" required></label>
                        <button class="button-secondary" type="submit">{{t $.Lang "reject"}}</button>
                      </form>
                    </div>
                    {{else}}
                    <p>{{t $.Lang "read_only"}}</p>
                    {{end}}
                    {{if and (eq .Status "pending") (eq .CreationSource "admin")}}
                    {{if and (index $.Permissions "requests.manage") (or (eq .CreatedByID $.CurrentUser.ID) (eq $.Role "super_admin"))}}
                    <form class="inline-rejection-form review-action" method="post" action="/api/admin/loan-requests/{{.ID}}/cancel" hx-post="/api/admin/loan-requests/{{.ID}}/cancel" hx-target="#loan-review-error" hx-swap="innerHTML">
                      <label>{{t $.Lang "admin_loan_cancellation_reason"}} <input name="cancellation_reason" required></label>
                      <button class="button-secondary" type="submit">{{t $.Lang "cancel"}}</button>
                    </form>
                    {{end}}
                    {{end}}
                    {{if .ApprovalHistory}}<section class="review-approval-history"><h3>{{t $.Lang "approval_history"}}</h3><ol>{{range .ApprovalHistory}}<li>{{t $.Lang (printf "role_%s" .OfficerRole)}} — {{t $.Lang (printf "status_%s" .Decision)}} — {{.OfficerName}} — {{.CreatedAt}}{{if .Note}} · {{.Note}}{{end}}{{if .Reason}} · {{.Reason}}{{end}}</li>{{end}}</ol></section>{{end}}
                  </div>
                </div>
              </td>
            </tr>
            {{end}}
          </tbody>
{{template "table-close" .}}
        {{else}}
{{template "empty-state" (t .Lang "no_pending_loan_requests")}}
        {{end}}
{{template "form-error" (dict "ID" "loan-review-error")}}
      </section>
{{template "admin-shell-end" .}}
{{end}}

{{define "admin-loans"}}
{{template "admin-shell-start" .}}
      <section class="page-actions">
        <a class="button-link button-link-secondary" href="/api/admin/exports/loans.csv">{{t .Lang "export_csv"}}</a>
      </section>
      <section class="panel">
        <form class="filter-form member-search-form" method="get" action="/admin/loans" role="search">
          <label for="admin-loan-search">{{t .Lang "search_loans"}}
            <input id="admin-loan-search" type="search" name="search" value="{{.LoanSearch}}" placeholder="{{t .Lang "search_loans_placeholder"}}">
          </label>
          <label for="admin-loan-type">{{t .Lang "loan_type"}}
            <select id="admin-loan-type" name="loan_type">
              <option value="">{{t .Lang "all_loan_types"}}</option>
              <option value="regular" {{if eq .LoanTypeFilter "regular"}}selected{{end}}>{{t .Lang "loan_type_regular"}}</option>
              <option value="secondary_goods" {{if eq .LoanTypeFilter "secondary_goods"}}selected{{end}}>{{t .Lang "loan_type_secondary_goods"}}</option>
              <option value="goods_purchase_paylater" {{if eq .LoanTypeFilter "goods_purchase_paylater"}}selected{{end}}>{{t .Lang "loan_type_goods_purchase_paylater"}}</option>
            </select>
          </label>
          <label for="admin-loan-status">{{t .Lang "status"}}
            <select id="admin-loan-status" name="status">
              <option value="">{{t .Lang "all_statuses"}}</option>
              <option value="active" {{if eq .LoanStatusFilter "active"}}selected{{end}}>{{t .Lang "status_active"}}</option>
              <option value="adjustment_due" {{if eq .LoanStatusFilter "adjustment_due"}}selected{{end}}>{{t .Lang "status_adjustment_due"}}</option>
              <option value="paid" {{if eq .LoanStatusFilter "paid"}}selected{{end}}>{{t .Lang "status_paid"}}</option>
              <option value="cancelled" {{if eq .LoanStatusFilter "cancelled"}}selected{{end}}>{{t .Lang "status_cancelled"}}</option>
            </select>
          </label>
          <button type="submit">{{t .Lang "search"}}</button>
          <a class="button-link button-link-secondary" href="/admin/loans">{{t .Lang "reset"}}</a>
        </form>
        {{if .Loans}}
{{template "table-open" .}}
          <thead>
            <tr>
              <th>{{t $.Lang "member"}}</th>
              <th>{{t $.Lang "loan_type"}}</th>
              <th>{{t $.Lang "approved"}}</th>
              <th>{{t $.Lang "installment"}}</th>
              <th>{{t $.Lang "remaining"}}</th>
              <th>{{t $.Lang "final_due_date"}}</th>
              <th>{{t $.Lang "duration"}}</th>
              <th>{{t $.Lang "status"}}</th>
              <th>{{t $.Lang "repayment"}}</th>
              <th>{{t $.Lang "details"}}</th>
            </tr>
          </thead>
          <tbody>
            {{range .Loans}}
            <tr class="{{if .IsOverdue}}loan-overdue-row{{end}}">
              <td>{{template "member-table-cell" .}}</td>
              <td>{{template "loan-type-label" (dict "Lang" $.Lang "LoanType" .LoanType "LegacyTerms" .LegacyTerms)}}</td>
              <td>{{nominal .ApprovedAmount}}</td>
              <td>{{nominal .MonthlyInstallment}}</td>
              <td>{{nominal .RemainingBalance}}</td>
              <td>{{.FinalDueDate}}{{if .IsOverdue}} <strong>{{t $.Lang "overdue"}}</strong>{{end}}</td>
              <td>{{.DurationMonths}} {{t $.Lang "months"}}</td>
              <td>{{template "status-badge" (dict "Lang" $.Lang "Status" .Status)}}</td>
              <td>
                {{if or (eq .Status "active") (eq .Status "adjustment_due")}}
                <form class="inline-repayment-form" method="post" action="/api/admin/loans/{{.ID}}/repayments" hx-post="/api/admin/loans/{{.ID}}/repayments" hx-target="#repayment-form-error" hx-swap="innerHTML">
                  <input name="amount" type="text" inputmode="numeric" placeholder="Rp 0" data-rupiah-input data-rupiah-group="{{if eq $.Lang "id"}}.{{else}},{{end}}" data-rupiah-invalid="{{t $.Lang "error_invalid_rupiah_amount"}}" data-rupiah-max="{{.RemainingBalance}}" data-rupiah-max-invalid="{{t $.Lang "error_loan_repayment_over_balance"}}" title="{{t $.Lang "rupiah_input_hint"}}" aria-label="{{t $.Lang "repayment_amount"}}" aria-errormessage="repayment-amount-error-{{.ID}}" required>
                  <span id="repayment-amount-error-{{.ID}}" class="form-error-message" aria-live="polite" hidden></span>
                  <input name="record_date" type="date" value="{{$.CurrentDate}}" aria-label="{{t $.Lang "repayment_date"}}" required>
                  <input name="reference_no" placeholder="{{t $.Lang "reference"}}" aria-label="{{t $.Lang "reference_number"}}">
                  {{if index $.Permissions "accounting_coa.override"}}
                  <select name="cash_coa_code" aria-label="{{t $.Lang "cash_bank_account"}}"><option value="">{{t $.Lang "use_mapping"}}</option>{{range $.COAAccounts}}<option value="{{.Code}}">{{.Code}} - {{.Name}}</option>{{end}}</select>
                  <select name="coa_code" aria-label="{{t $.Lang "loan_receivable_account"}}"><option value="">{{t $.Lang "use_mapping"}}</option>{{range $.COAAccounts}}<option value="{{.Code}}">{{.Code}} - {{.Name}}</option>{{end}}</select>
                  {{end}}
                  <input name="note" placeholder="{{t $.Lang "note"}}" aria-label="{{t $.Lang "repayment_note"}}">
                  <button type="submit">{{t $.Lang "record_repayment"}}</button>
                </form>
                {{end}}
              </td>
              <td><a class="button-link button-link-secondary" href="/admin/loans/{{.ID}}">{{t $.Lang "view_details"}}</a></td>
            </tr>
            {{end}}
          </tbody>
{{template "table-close" .}}
        {{else}}
{{template "empty-state" (t .Lang "no_matching_loans")}}
        {{end}}
{{template "form-error" (dict "ID" "repayment-form-error")}}
      </section>
{{template "admin-shell-end" .}}
{{end}}

