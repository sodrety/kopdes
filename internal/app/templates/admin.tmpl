              <th>{{t $.Lang "member"}}</th>
              <th>{{t $.Lang "loan_type"}}</th>
              <th>{{t $.Lang "amount"}}</th>
              <th>{{t $.Lang "duration"}}</th>
              <th>{{t $.Lang "purpose"}}</th>
              <th>{{t $.Lang "status"}}</th>
              <th>{{t $.Lang "admin_loan_source"}}</th>
              <th>{{t $.Lang "admin_loan_creator"}}</th>
              <th>{{t $.Lang "admin_loan_batch_id"}}</th>
              <th>{{t $.Lang "created"}}</th>
              <th>{{t $.Lang "review"}}</th>
            </tr>
          </thead>
          <tbody>
            {{range .LoanRequests}}
            <tr>
              <td>{{template "member-table-cell" .}}</td>
              <td>{{template "loan-type-label" (dict "Lang" $.Lang "LoanType" .LoanType "LegacyTerms" .LegacyTerms)}}</td>
              <td>{{nominal .RequestedAmount}}</td>
              <td>{{.DurationMonths}} {{t $.Lang "months"}}</td>
              <td>{{.Purpose}}</td>
              <td>{{template "status-badge" (dict "Lang" $.Lang "Status" .Status)}}{{if .CurrentApprovalStage}}<small>{{t $.Lang "awaiting"}} {{t $.Lang (printf "role_%s" .CurrentApprovalStage)}}</small>{{end}}</td>
              <td>{{t $.Lang (printf "admin_loan_source_%s" .CreationSource)}}</td>
              <td>{{if .CreatedByName}}{{.CreatedByName}}{{else}}{{t $.Lang "none"}}{{end}}</td>
              <td>{{if .BatchID}}<a href="/admin/loan-request-batches/{{.BatchID}}">{{.BatchID}}</a>{{else}}{{t $.Lang "none"}}{{end}}</td>
