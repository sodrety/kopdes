      <section class="panel">
        <h2>{{t .Lang "simpanan_report"}}</h2>
        {{if .Reports.SavingsByMember}}
{{template "table-open" .}}
          <thead>
            <tr>
              <th>{{t $.Lang "member"}}</th>
              <th>{{t $.Lang "member_type"}}</th>
              <th>{{t $.Lang "simpanan_pokok"}}</th>
              <th>{{t $.Lang "simpanan_wajib"}}</th>
              <th>{{t $.Lang "simpanan_sukarela"}}</th>
              <th>{{t $.Lang "total"}}</th>
            </tr>
          </thead>
          <tbody>
            {{range .Reports.SavingsByMember}}
            <tr>
              <td>{{template "member-table-cell" .}}</td>
              <td>{{.MemberTypeLabel}}</td>
              <td>{{nominal .Pokok}}</td>
              <td>{{nominal .Wajib}}</td>
              <td>{{nominal .Sukarela}}</td>
              <td>{{nominal .Total}}</td>
            </tr>
            {{end}}
          </tbody>
{{template "table-close" .}}
        {{else}}
{{template "empty-state" (t .Lang "no_report_data")}}
        {{end}}
      </section>
      <section class="panel">
        <h2>{{t .Lang "penarikan_report"}}</h2>
        {{if .Reports.WithdrawalsByMember}}
{{template "table-open" .}}
          <thead>
            <tr>
              <th>{{t $.Lang "member"}}</th>
              <th>{{t $.Lang "member_type"}}</th>
              <th>{{t $.Lang "status_pending"}}</th>
              <th>{{t $.Lang "status_approved"}}</th>
              <th>{{t $.Lang "status_rejected"}}</th>
              <th>{{t $.Lang "total"}}</th>
            </tr>
          </thead>
          <tbody>
            {{range .Reports.WithdrawalsByMember}}
            <tr>
              <td>{{template "member-table-cell" .}}</td>
              <td>{{.MemberTypeLabel}}</td>
              <td>{{.Pending}}</td>
              <td>{{.Approved}}</td>
              <td>{{.Rejected}}</td>
              <td>{{nominal .Total}}</td>
            </tr>
            {{end}}
          </tbody>
{{template "table-close" .}}
        {{else}}
{{template "empty-state" (t .Lang "no_report_data")}}
        {{end}}
      </section>
      <section class="panel">
        <h2>{{t .Lang "pinjaman_report"}}</h2>
        {{if .Reports.Loans}}
{{template "table-open" .}}
          <thead>
            <tr>
              <th>{{t $.Lang "member"}}</th>
              <th>{{t $.Lang "member_type"}}</th>
              <th>{{t $.Lang "approved_amount"}}</th>
              <th>{{t $.Lang "start_date"}}</th>
			  <th>{{t $.Lang "monthly_admin_fee"}}</th>
              <th>{{t $.Lang "total_obligation"}}</th>
              <th>{{t $.Lang "monthly_installment"}}</th>
              <th>{{t $.Lang "remaining_balance"}}</th>
              <th>{{t $.Lang "next_due_date"}}</th>
              <th>{{t $.Lang "final_due_date"}}</th>
              <th>{{t $.Lang "status"}}</th>
            </tr>
          </thead>
          <tbody>
            {{range .Reports.Loans}}
            <tr>
              <td>{{template "member-table-cell" .}}</td>
              <td>{{.MemberTypeLabel}}</td>
              <td>{{nominal .ApprovedAmount}}</td>
              <td>{{.StartDate}}</td>
			  <td>{{nominal .MonthlyAdminFee}}</td>
              <td>{{nominal .TotalObligation}}</td>
              <td>{{nominal .MonthlyInstallment}}</td>
              <td>{{nominal .RemainingBalance}}</td>
              <td>{{.NextDueDate}}</td>
              <td>{{.FinalDueDate}}</td>
              <td>{{template "status-badge" (dict "Lang" $.Lang "Status" .Status)}}</td>
            </tr>
            {{end}}
          </tbody>
{{template "table-close" .}}
        {{else}}
{{template "empty-state" (t .Lang "no_report_data")}}
        {{end}}
      </section>
      <section class="panel">
        <h2>{{t .Lang "angsuran_report"}}</h2>
        {{if .Reports.Repayments}}
{{template "table-open" .}}
          <thead>
            <tr>
              <th>{{t $.Lang "date"}}</th>
              <th>{{t $.Lang "member"}}</th>
              <th>{{t $.Lang "member_type"}}</th>
              <th>{{t $.Lang "repayment_type"}}</th>
              <th>{{t $.Lang "amount"}}</th>
              <th>{{t $.Lang "reference"}}</th>
            </tr>
          </thead>
          <tbody>
            {{range .Reports.Repayments}}
            <tr class="{{if eq .Type "adjustment"}}historical-adjustment-row{{else if eq .Type "suspension"}}historical-suspension-row{{end}}">
              <td>{{.RecordDate}}</td>
              <td>{{template "member-table-cell" .}}</td>
              <td>{{.MemberTypeLabel}}</td>
              <td>{{t $.Lang (printf "repayment_type_%s" .Type)}}</td>
              <td>{{nominal .Amount}}</td>
              <td>{{.ReferenceNo}}</td>
            </tr>
            {{end}}
          </tbody>
{{template "table-close" .}}
        {{else}}
{{template "empty-state" (t .Lang "no_report_data")}}
        {{end}}
      </section>
{{template "admin-shell-end" .}}
{{end}}

{{define "admin-coa"}}
{{template "admin-shell-start" .}}
      <section class="panel">
        <h2>{{t .Lang "coa_import_draft"}}</h2>
        <p class="field-help">{{t .Lang "coa_import_description"}}</p>
        <form class="filter-form" method="post" action="/api/admin/coa/import" enctype="multipart/form-data">
          <label>{{t .Lang "xlsx_file"}} <input type="file" name="file" accept=".xlsx,application/vnd.openxmlformats-officedocument.spreadsheetml.sheet" required></label>
          <button type="submit">{{t .Lang "upload_coa_draft"}}</button>
        </form>
      </section>
      <section class="panel">
        <h2>{{t .Lang "accounting_mapping"}}</h2>
        <p class="field-help">{{t .Lang "accounting_mapping_description"}}</p>
        <form class="filter-form" method="post" action="/api/admin/accounting-mappings">
          <label>{{t .Lang "transaction_type"}} <input name="transaction_type" required></label>
          <label>{{t .Lang "component"}} <input name="component" required></label>
          <label>{{t .Lang "loan_type"}} <input name="loan_type"></label>
          <label>{{t .Lang "coa_account"}}
            <select name="coa_code" required>
              <option value="">{{t .Lang "select_coa_account"}}</option>
              {{range .COAAccounts}}{{if .Active}}{{if not .IsGroup}}<option value="{{.Code}}">{{.Code}} - {{.Name}}</option>{{end}}{{end}}{{end}}
            </select>
          </label>
          <label>{{t .Lang "effective_from"}} <input type="date" name="effective_from"></label>
          <label>{{t .Lang "effective_to"}} <input type="date" name="effective_to"></label>
          <label>{{t .Lang "active"}} <select name="active"><option value="true" selected>{{t .Lang "active"}}</option><option value="false">{{t .Lang "inactive"}}</option></select></label>
          <button type="submit">{{t .Lang "save_mapping"}}</button>
        </form>
      </section>
      <section class="panel">
        <h2>{{t .Lang "accounting_mappings"}}</h2>
        {{if .Mappings}}
{{template "table-open" .}}
          <thead><tr><th>{{t $.Lang "transaction_type"}}</th><th>{{t $.Lang "component"}}</th><th>{{t $.Lang "loan_type"}}</th><th>{{t $.Lang "coa_account"}}</th><th>{{t $.Lang "effective_from"}}</th><th>{{t $.Lang "effective_to"}}</th><th>{{t $.Lang "active"}}</th><th>{{t $.Lang "action"}}</th></tr></thead>
          <tbody>
            {{range $mapping := .Mappings}}
            <tr>
              <td><input form="mapping-{{$mapping.ID}}" name="transaction_type" value="{{$mapping.TransactionType}}" required></td>
              <td><input form="mapping-{{$mapping.ID}}" name="component" value="{{$mapping.Component}}" required></td>
              <td><input form="mapping-{{$mapping.ID}}" name="loan_type" value="{{$mapping.LoanType}}"></td>
              <td><select form="mapping-{{$mapping.ID}}" name="coa_code" required>{{range $.COAAccounts}}{{if .Active}}{{if not .IsGroup}}<option value="{{.Code}}" {{if eq .Code $mapping.COACode}}selected{{end}}>{{.Code}} - {{.Name}}</option>{{end}}{{end}}{{end}}</select></td>
              <td><input form="mapping-{{$mapping.ID}}" type="date" name="effective_from" value="{{$mapping.EffectiveFrom}}"></td>
              <td><input form="mapping-{{$mapping.ID}}" type="date" name="effective_to" value="{{$mapping.EffectiveTo}}"></td>
              <td><select form="mapping-{{$mapping.ID}}" name="active"><option value="true" {{if $mapping.Active}}selected{{end}}>{{t $.Lang "active"}}</option><option value="false" {{if not $mapping.Active}}selected{{end}}>{{t $.Lang "inactive"}}</option></select></td>
              <td><form id="mapping-{{$mapping.ID}}" method="post" action="/api/admin/accounting-mappings/{{$mapping.ID}}/update"><button type="submit">{{t $.Lang "save"}}</button></form></td>
            </tr>
            {{end}}
          </tbody>
{{template "table-close" .}}
        {{else}}
{{template "empty-state" (t .Lang "no_accounting_mappings")}}
        {{end}}
      </section>
{{template "admin-shell-end" .}}
{{end}}

{{define "admin-tagihan"}}
{{template "admin-shell-start" .}}
      <section class="panel">
        <h2>{{t .Lang "generate_tagihan"}}</h2>
        <form class="filter-form" method="get" action="/admin/tagihan">
          <label>{{t .Lang "statement_month"}}
            <input type="month" name="month" value="{{.StatementMonth}}" required>
          </label>
          <button type="submit">{{t .Lang "apply_filters"}}</button>
          <a class="button-link" href="/api/admin/tagihan/export.xlsx?month={{.StatementMonth}}">{{t .Lang "export_xlsx"}}</a>
        </form>
      </section>
      <section class="panel">
        <h2>{{t .Lang "tagihan_saving_configuration"}}</h2>
        <div class="form-grid form-grid-two">
          <div><span>{{t .Lang "tagihan_saving_source"}}</span><strong>{{t .Lang "tagihan_saving_source_latest_member"}}</strong></div>
        </div>
        <p>{{t .Lang "tagihan_saving_configuration_description"}}</p>
        {{if .TagihanConfig.ReadOnly}}<p>{{t .Lang "read_only"}}</p>{{end}}
      </section>
      <section class="panel">
        <h2>{{t .Lang "import_tagihan"}}</h2>
        <p class="field-help">{{t .Lang "tagihan_source_help"}}</p>
        <form class="filter-form" method="post" action="/api/admin/tagihan/import" enctype="multipart/form-data">
          <label>{{t .Lang "statement_month"}}
            <input type="month" name="statement_month" value="{{.StatementMonth}}" required>
          </label>
          <label>{{t .Lang "record_date"}}
            <input type="date" name="record_date" value="{{.DefaultDate}}">
          </label>
          <label>{{t .Lang "xlsx_file"}}
            <input type="file" name="file" accept=".xlsx,application/vnd.openxmlformats-officedocument.spreadsheetml.sheet" required>
          </label>
          <button type="submit">{{t .Lang "import_tagihan"}}</button>
        </form>
      </section>
      <section class="panel">
        <h2>{{t .Lang "tagihan_preview"}}</h2>
        {{if .Rows}}
{{template "table-open" .}}
          <thead>
            <tr>
              <th>{{t $.Lang "member_id"}}</th>
              <th>{{t $.Lang "member_no"}}</th>
              <th>{{t $.Lang "full_name"}}</th>
              <th>{{t $.Lang "simpanan_wajib"}}</th>
              <th>{{t $.Lang "simpanan_manasuka"}}</th>
              <th>{{t $.Lang "pinjaman_reguler"}}</th>
              <th>{{t $.Lang "loan_type_secondary_goods"}}</th>
              <th>{{t $.Lang "loan_type_goods_purchase_paylater"}}</th>
              <th>{{t $.Lang "total_tagihan"}}</th>
              <th>{{t $.Lang "source"}}</th>
              <th>{{t $.Lang "status"}}</th>
            </tr>
          </thead>
          <tbody>
            {{range .Rows}}
            <tr>
              <td>{{.MemberID}}</td>
              <td>{{.MemberNo}}</td>
              <td>{{.FullName}}</td>
              <td>{{nominal .SimpananWajib}}</td>
              <td>{{nominal .SimpananSukarela}}</td>
              <td>{{nominal .PinjamanReguler}}</td>
              <td>{{nominal .PinjamanBarangSekunder}}</td>
              <td>{{nominal .PembelianBarang}}</td>
              <td>{{nominal .Total}}</td>
              <td>{{if .Source}}{{.Source}}{{else}}-{{end}}</td>
              <td>{{.Status}}</td>
            </tr>
            {{end}}
          </tbody>
{{template "table-close" .}}
        {{else}}
{{template "empty-state" (t .Lang "no_tagihan_rows")}}
        {{end}}
      </section>
{{template "admin-shell-end" .}}
{{end}}

{{define "admin-balance-report"}}
{{template "admin-shell-start" .}}
      <section class="balance-report-card">
        <header class="balance-report-card-header">
          <h2>{{t .Lang "financial_balance_report"}}</h2>
          <div class="balance-export-actions">
            <a class="button-link button-link-secondary" href="/admin/reports/balance?export=csv">{{t .Lang "export_csv"}}</a>
            <a class="button-link button-link-secondary" href="/admin/reports/balance?export=pdf">{{t .Lang "export_pdf"}}</a>
          </div>
        </header>
        <div class="balance-report-card-body">
          <section class="balance-health-alert">
            <div>
              <span>{{t .Lang "financial_health_indicator"}}</span>
              <p>{{t .Lang "liability_asset_ratio"}} <strong>{{.Report.LiabilityRatio}}%</strong> - {{t .Lang "status"}}: <strong>{{t .Lang (printf "health_%s" .Report.HealthStatus)}}</strong></p>
            </div>
            <i data-lucide="triangle-alert"></i>
          </section>

          <section class="balance-kpi-grid">
            <article class="balance-kpi-card balance-kpi-primary">
              <i class="kpi-card-icon" data-lucide="landmark" aria-hidden="true"></i>
              <span>{{t .Lang "total_assets"}}</span>
              <strong>Rp {{nominal .Report.TotalAssets}}</strong>
              <small>{{t .Lang "cash_plus_loan_receivable"}}</small>
            </article>
            <article class="balance-kpi-card balance-kpi-warning">
              <i class="kpi-card-icon" data-lucide="piggy-bank" aria-hidden="true"></i>
              <span>{{t .Lang "total_liabilities"}}</span>
              <strong>Rp {{nominal .Report.TotalLiabilities}}</strong>
              <small>{{t .Lang "member_savings"}}</small>
            </article>
            <article class="balance-kpi-card balance-kpi-success">
              <i class="kpi-card-icon" data-lucide="scale" aria-hidden="true"></i>
              <span>{{t .Lang "total_equity"}}</span>
              <strong>Rp {{nominal .Report.TotalEquity}}</strong>
              <small>{{t .Lang "assets_minus_liabilities"}}</small>
            </article>
          </section>

          <section class="balance-detail-card">
            <h3><i data-lucide="scale"></i> {{t .Lang "balance_detail"}}</h3>
{{template "table-open" .}}
          <thead>
            <tr>
              <th>{{t $.Lang "category"}}</th>
              <th>{{t $.Lang "amount_rp"}}</th>
            </tr>
          </thead>
          <tbody>
            <tr class="balance-section-row">
