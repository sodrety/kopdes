      <section class="panel">
        <h2>{{t .Lang "installment_schedule"}}</h2>
        {{if .Installments}}{{template "table-open" .}}<thead><tr><th>#</th><th>{{t $.Lang "due_date"}}</th><th>{{t $.Lang "scheduled_amount"}}</th><th>{{t $.Lang "paid_amount"}}</th><th>{{t $.Lang "unpaid_amount"}}</th></tr></thead><tbody>{{range .Installments}}<tr><td>{{.InstallmentNo}}</td><td>{{.DueDate}}</td><td>{{nominal .ScheduledAmount}}</td><td>{{nominal .PaidAmount}}</td><td>{{nominal (sub .ScheduledAmount .PaidAmount)}}</td></tr>{{end}}</tbody>{{template "table-close" .}}{{else}}{{template "empty-state" (t .Lang "no_installments")}}{{end}}
      </section>
      <section class="panel">
        <h2>{{t .Lang "repayment_history"}}</h2>
        {{if .Repayments}}
{{template "table-open" .}}
          <thead><tr>
            <th>{{t .Lang "date"}}</th>
            <th>{{t .Lang "repayment_type"}}</th>
            <th>{{t .Lang "amount"}}</th>
            <th>{{t .Lang "reference"}}</th>
            <th>{{t .Lang "note"}}</th>
            {{if .CanCorrect}}<th>{{t .Lang "repayment_audit_action"}}</th>{{end}}
          </tr></thead>
          <tbody>{{range .Repayments}}<tr>
            <td>{{.RecordDate}}</td>
            <td>{{t $.Lang (printf "repayment_type_%s" .Type)}}</td>
            <td>{{nominal .Amount}}</td>
            <td>{{.ReferenceNo}}</td>
            <td>{{.Note}}</td>
            {{if $.CanCorrect}}<td>{{if eq .Type "repayment"}}<a class="button-link button-link-secondary" href="#repayment-edit-{{.ID}}">{{t $.Lang "edit_repayment"}}</a>{{else}}—{{end}}</td>{{end}}
          </tr>{{end}}</tbody>
{{template "table-close" .}}
        {{else}}
{{template "empty-state" (t .Lang "no_repayments")}}
        {{end}}
      </section>
      {{if .CanCorrect}}
      {{range .Repayments}}
      {{if eq .Type "repayment"}}
      {{template "repayment-edit-modal" (dict "Lang" $.Lang "Repayment" . "ReturnTo" (printf "/admin/loans/%s" $.Loan.ID))}}
      {{end}}
      {{end}}
      {{end}}
{{template "admin-shell-end" .}}
{{end}}

{{define "admin-withdrawal-requests"}}
{{template "admin-shell-start" .}}
      <section class="page-actions">
        <a class="button-link button-link-secondary" href="/api/admin/exports/withdrawal-requests.csv?status=pending">{{t .Lang "export_csv"}}</a>
      </section>
      {{if .CanManage}}
      <section class="panel form-panel">
        <h2>{{t .Lang "officer_withdrawal_request_form_title"}}</h2>
        <p class="field-help">{{t .Lang "officer_withdrawal_request_form_help"}}</p>
        <form method="post" action="/api/admin/withdrawal-requests/on-behalf" hx-post="/api/admin/withdrawal-requests/on-behalf" hx-target="#officer-withdrawal-error" hx-swap="innerHTML">
          <label>{{t .Lang "member"}}
            <input name="member_no" list="withdrawal-request-members" autocomplete="off" required>
            <datalist id="withdrawal-request-members">{{range .Members}}<option value="{{.MemberNo}}">{{.FullName}}</option>{{end}}</datalist>
          </label>
          <label>{{t .Lang "amount"}} <input name="amount" type="text" inputmode="numeric" data-rupiah-input data-rupiah-group="{{if eq .Lang "id"}}.{{else}},{{end}}" data-rupiah-invalid="{{t .Lang "error_invalid_rupiah_amount"}}" required></label>
          <label>{{t .Lang "note"}} <input name="note" maxlength="500"></label>
          <button type="submit">{{t .Lang "create_withdrawal_request"}}</button>
        </form>
        {{template "form-error" (dict "ID" "officer-withdrawal-error")}}
      </section>
      {{end}}
      <section class="panel">
        <h2>{{t .Lang "member_deactivation_requests_title"}}</h2>
        {{if .DeactivationRequests}}
        <div class="content-grid">
          {{range .DeactivationRequests}}
          <article class="panel form-panel">
            <h3><a href="/admin/members/{{.MemberID}}">{{.MemberNo}} · {{.FullName}}</a></h3>
            <p>{{t $.Lang "member_deactivation_reason"}}: {{.Reason}}</p>
            <div class="detail-grid">
              <div><span>{{t $.Lang "member_deactivation_payout_total"}}</span><strong>{{nominal .TotalPayout}}</strong></div>
              <div><span>{{t $.Lang "outstanding_loan"}}</span><strong>{{nominal .OutstandingLoan}}</strong></div>
              {{if .PayoutSource}}<div><span>{{t $.Lang "member_deactivation_payout_method"}}</span><strong>{{t $.Lang .PayoutSource}}</strong></div>{{end}}
            </div>
            <ul class="compact-list">{{range .Balances}}<li>{{t $.Lang (printf "simpanan_%s" .Category)}}: {{nominal .Amount}}</li>{{end}}</ul>
            <p class="field-help">{{t $.Lang "member_deactivation_loan_separate"}}</p>
            {{if .CanDecide}}
            <div class="table-actions">
              <form method="post" action="/api/admin/member-deactivation-requests/{{.ID}}/approve" hx-post="/api/admin/member-deactivation-requests/{{.ID}}/approve" hx-target="#member-deactivation-review-error" hx-swap="innerHTML">
                {{if eq .CurrentApprovalStage "manager"}}
                <fieldset>
                  <legend>{{t $.Lang "member_deactivation_payout_method"}}</legend>
                  <label><input type="radio" name="payout_source" value="cash" required> {{t $.Lang "cash"}}</label>
                  {{if and .BankName .BankAccount}}<label><input type="radio" name="payout_source" value="bank" required> {{t $.Lang "bank"}} · {{.BankName}} · {{.BankAccount}}</label>{{end}}
                  {{if not (and .BankName .BankAccount)}}<p class="field-help">{{t $.Lang "member_deactivation_bank_details_missing"}}</p>{{end}}
                </fieldset>
                {{end}}
                <label>{{t $.Lang "approval_note_optional"}} <input name="note" maxlength="500"></label>
                <button type="submit">{{t $.Lang "approve"}}</button>
              </form>
              <form class="inline-rejection-form" method="post" action="/api/admin/member-deactivation-requests/{{.ID}}/reject" hx-post="/api/admin/member-deactivation-requests/{{.ID}}/reject" hx-target="#member-deactivation-review-error" hx-swap="innerHTML">
                <label>{{t $.Lang "member_deactivation_rejection_reason"}} <input name="reason" maxlength="1000" required></label>
                <button class="button-secondary" type="submit">{{t $.Lang "reject"}}</button>
              </form>
            </div>
            {{else}}
            <p>{{t $.Lang "awaiting"}} {{t $.Lang (printf "role_%s" .CurrentApprovalStage)}}</p>
            {{end}}
            {{if .ApprovalHistory}}
            <details><summary>{{t $.Lang "approval_history"}}</summary><ul class="compact-list">{{range .ApprovalHistory}}<li>{{t $.Lang (printf "role_%s" .Stage)}} · {{t $.Lang .Decision}} · {{.OfficerName}}{{if .Reason}}: {{.Reason}}{{end}}</li>{{end}}</ul></details>
            {{end}}
          </article>
          {{end}}
        </div>
        {{else}}
        {{template "empty-state" (t .Lang "member_deactivation_no_requests")}}
        {{end}}
        {{template "form-error" (dict "ID" "member-deactivation-review-error")}}
      </section>
      <section class="panel">
        {{if .WithdrawalRequests}}
{{template "table-open" .}}
          <thead>
            <tr>
              <th>{{t $.Lang "member"}}</th>
              <th>{{t $.Lang "amount"}}</th>
              <th>{{t $.Lang "note"}}</th>
              <th>{{t $.Lang "status"}}</th>
              <th>{{t $.Lang "review"}}</th>
            </tr>
          </thead>
          <tbody>
            {{range .WithdrawalRequests}}
            <tr>
              <td>{{template "member-table-cell" .}}</td>
              <td>{{nominal .Amount}}</td>
              <td>{{.Note}}</td>
              <td>{{template "status-badge" (dict "Lang" $.Lang "Status" .Status)}}{{if .CurrentApprovalStage}}<small>{{t $.Lang "awaiting"}} {{t $.Lang (printf "role_%s" .CurrentApprovalStage)}}</small>{{end}}</td>
              <td class="review-cell">
                {{if and $.CanManage (eq .CreationSource "officer") (eq .Status "pending") (eq .CurrentApprovalStage "manager")}}
                <form method="post" action="/api/admin/withdrawal-requests/{{.ID}}/update" hx-post="/api/admin/withdrawal-requests/{{.ID}}/update" hx-target="#withdrawal-review-error" hx-swap="innerHTML">
                  <label>{{t $.Lang "amount"}} <input name="amount" type="text" inputmode="numeric" value="{{nominal .Amount}}" data-rupiah-input data-rupiah-group="{{if eq $.Lang "id"}}.{{else}},{{end}}" required></label>
                  <label>{{t $.Lang "note"}} <input name="note" maxlength="500" value="{{.Note}}"></label>
                  <button class="button-secondary" type="submit">{{t $.Lang "save"}}</button>
                </form>
                {{end}}
                {{if and (eq $.Role "super_admin") (index $.Permissions "requests.override") (eq .Status "pending")}}
                <div class="table-actions">
                  <strong>{{t $.Lang "super_admin_override"}}</strong>
                  <form method="post" action="/api/admin/withdrawal-requests/{{.ID}}/override-approve" hx-post="/api/admin/withdrawal-requests/{{.ID}}/override-approve" hx-target="#withdrawal-review-error" hx-swap="innerHTML">
                    {{if index $.Permissions "accounting_coa.override"}}
                    <label>{{t $.Lang "cash_bank_account"}} <select name="cash_coa_code"><option value="">{{t $.Lang "use_mapping"}}</option>{{range $.COAAccounts}}<option value="{{.Code}}">{{.Code}} - {{.Name}}</option>{{end}}</select></label>
                    <label>{{t $.Lang "savings_liability_account"}} <select name="coa_code"><option value="">{{t $.Lang "use_mapping"}}</option>{{range $.COAAccounts}}<option value="{{.Code}}">{{.Code}} - {{.Name}}</option>{{end}}</select></label>
                    {{end}}
                    <input name="note" placeholder="{{t $.Lang "approval_note_optional"}}" aria-label="{{t $.Lang "approval_note_optional"}}">
                    <button type="submit">{{t $.Lang "super_admin_approve"}}</button>
                  </form>
                  <form class="inline-rejection-form" method="post" action="/api/admin/withdrawal-requests/{{.ID}}/override-reject" hx-post="/api/admin/withdrawal-requests/{{.ID}}/override-reject" hx-target="#withdrawal-review-error" hx-swap="innerHTML">
                    <input name="rejection_reason" placeholder="{{t $.Lang "rejection_reason"}}" aria-label="{{t $.Lang "rejection_reason"}}">
                    <button class="button-secondary" type="submit">{{t $.Lang "super_admin_reject"}}</button>
                  </form>
                </div>
                {{else if and (eq .CurrentApprovalStage "manager") (or (eq $.Role "manager") (eq $.Role "admin")) (index $.Permissions "requests.decide")}}
                <div class="table-actions">
                  <form method="post" action="/api/admin/withdrawal-requests/{{.ID}}/approve" hx-post="/api/admin/withdrawal-requests/{{.ID}}/approve" hx-target="#withdrawal-review-error" hx-swap="innerHTML">
                    {{if index $.Permissions "accounting_coa.override"}}
                    <label>{{t $.Lang "cash_bank_account"}} <select name="cash_coa_code"><option value="">{{t $.Lang "use_mapping"}}</option>{{range $.COAAccounts}}<option value="{{.Code}}">{{.Code}} - {{.Name}}</option>{{end}}</select></label>
                    <label>{{t $.Lang "savings_liability_account"}} <select name="coa_code"><option value="">{{t $.Lang "use_mapping"}}</option>{{range $.COAAccounts}}<option value="{{.Code}}">{{.Code}} - {{.Name}}</option>{{end}}</select></label>
                    {{end}}
                    <input name="note" placeholder="{{t $.Lang "approval_note_optional"}}" aria-label="{{t $.Lang "approval_note_optional"}}">
                    <button type="submit">{{t $.Lang "approve"}}</button>
                  </form>
                </div>
                <form class="inline-rejection-form" method="post" action="/api/admin/withdrawal-requests/{{.ID}}/reject" hx-post="/api/admin/withdrawal-requests/{{.ID}}/reject" hx-target="#withdrawal-review-error" hx-swap="innerHTML">
                  <input name="rejection_reason" placeholder="{{t $.Lang "rejection_reason"}}" aria-label="{{t $.Lang "rejection_reason"}}" required>
                  <button class="button-secondary" type="submit">{{t $.Lang "reject"}}</button>
                </form>
                {{else}}<span>{{t $.Lang "read_only"}}</span>{{end}}
                {{if .ApprovalHistory}}<details><summary>{{t $.Lang "approval_history"}}</summary><ol>{{range .ApprovalHistory}}<li>{{t $.Lang (printf "role_%s" .OfficerRole)}} — {{t $.Lang (printf "status_%s" .Decision)}} — {{.OfficerName}} — {{.CreatedAt}}{{if .Note}} · {{.Note}}{{end}}{{if .Reason}} · {{.Reason}}{{end}}</li>{{end}}</ol></details>{{end}}
              </td>
            </tr>
            {{end}}
          </tbody>
{{template "table-close" .}}
{{template "form-error" (dict "ID" "withdrawal-review-error")}}
        {{else}}
{{template "empty-state" (t .Lang "no_pending_withdrawal_requests")}}
        {{end}}
      </section>
{{template "admin-shell-end" .}}
{{end}}

