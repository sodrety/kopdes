        <div class="section-heading-row">
          <div><h2>{{t .Lang "cash_transaction_category"}}</h2><p class="field-help">{{t .Lang "categories_description"}}</p></div>
          <div class="button-row"><a class="button-link button-link-secondary" href="/api/admin/transaction-categories/template.xlsx">{{t .Lang "download_category_template"}}</a><a class="button-link button-link-secondary" href="/admin/transactions">{{t .Lang "cash_transactions"}}</a></div>
