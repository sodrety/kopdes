{{define "admin-transactions"}}
{{template "admin-shell-start" .}}
      {{if .CanRecord}}
      <section class="panel form-panel">
        <h2>{{if .CashDraftID}}{{t .Lang "edit_draft"}}{{else}}{{t .Lang "record_manual_cash_transaction"}}{{end}}</h2>
        <p class="field-help">{{t .Lang "cash_transaction_form_help"}}</p>
        <form method="post" action="{{if .CashDraftID}}/api/admin/transactions/drafts/{{.CashDraftID}}{{else}}/api/admin/transactions{{end}}" hx-post="{{if .CashDraftID}}/api/admin/transactions/drafts/{{.CashDraftID}}{{else}}/api/admin/transactions{{end}}" hx-target="#cash-transaction-error" hx-swap="innerHTML">
          <div class="form-grid form-grid-two">
            <label>{{t .Lang "cash_transaction_category"}}
              <select name="category_id" required><option value="">{{t .Lang "select_transaction_category"}}</option>{{range .CashCategories}}{{if and .Active (not .IsGroup)}}<option value="{{.ID}}" {{if and $.CashDraftID (eq .ID $.CashEditDraft.CategoryID)}}selected{{end}}>{{.DisplayName}}</option>{{end}}{{end}}</select>
            </label>
            <label>{{t .Lang "date"}} <input name="transaction_date" type="date" value="{{if .CashDraftID}}{{.CashEditDraft.TransactionDate}}{{else}}{{.CurrentDate}}{{end}}" max="{{.CurrentDate}}" required></label>
            <label>{{t .Lang "reference_number"}} <input name="reference_no" maxlength="100" value="{{if .CashDraftID}}{{.CashEditDraft.ReferenceNo}}{{end}}"></label>
            <label>{{t .Lang "description"}} <input name="description" maxlength="200" value="{{if .CashDraftID}}{{.CashEditDraft.Description}}{{end}}" required></label>
            <label>{{t .Lang "note"}} <input name="note" maxlength="500" value="{{if .CashDraftID}}{{.CashEditDraft.Note}}{{end}}"></label>
          </div>
          <div class="table-scroll"><table class="data-table">
            <thead><tr><th>{{t .Lang "coa_account"}}</th><th>{{t .Lang "debit"}}</th><th>{{t .Lang "credit"}}</th><th>{{t .Lang "action"}}</th></tr></thead>
            <tbody data-cash-journal-lines>
              {{range $line := .CashFormLines}}<tr data-cash-journal-line>
                <td><select name="line_coa_code" required><option value="">{{t $.Lang "select_coa_account"}}</option>{{range $.COAAccounts}}<option value="{{.Code}}" {{if eq .Code $line.COACode}}selected{{end}}>{{.Code}} - {{.Name}}</option>{{end}}</select></td>
                <td><input name="debit_amount" type="text" inputmode="numeric" value="{{$line.Debit}}" data-rupiah-input data-rupiah-group="{{if eq $.Lang "id"}}.{{else}},{{end}}" aria-label="{{t $.Lang "debit"}}"></td>
                <td><input name="credit_amount" type="text" inputmode="numeric" value="{{$line.Credit}}" data-rupiah-input data-rupiah-group="{{if eq $.Lang "id"}}.{{else}},{{end}}" aria-label="{{t $.Lang "credit"}}"></td>
                <td><button type="button" class="button-secondary" data-cash-remove-line>{{t $.Lang "remove_line"}}</button></td>
              </tr>{{end}}
            </tbody>
          </table></div>
          <div class="journal-balance-summary" data-cash-journal-balance data-balanced="false" data-group-separator="{{if eq .Lang "id"}}.{{else}},{{end}}" data-balanced-message="{{t .Lang "journal_balanced"}}" data-unbalanced-message="{{t .Lang "journal_unbalanced"}}" aria-live="polite">
            <div><span>{{t .Lang "debit"}}</span><strong>Rp <span data-cash-debit-total>0</span></strong></div>
            <div><span>{{t .Lang "credit"}}</span><strong>Rp <span data-cash-credit-total>0</span></strong></div>
            <div><span>{{t .Lang "journal_difference"}}</span><strong>Rp <span data-cash-difference>0</span></strong></div>
            <p data-cash-balance-status>{{t .Lang "journal_unbalanced"}}</p>
          </div>
          <div class="button-row"><button type="button" class="button-secondary" data-cash-add-line>{{t .Lang "add_journal_line"}}</button><button type="submit" data-cash-submit disabled>{{t .Lang "submit_for_approval"}}</button></div>
        </form>
        {{template "form-error" (dict "ID" "cash-transaction-error")}}
      </section>
      <script>
      (function () {
        var body = document.querySelector('[data-cash-journal-lines]');
        var add = document.querySelector('[data-cash-add-line]');
        var summary = document.querySelector('[data-cash-journal-balance]');
        if (!body || !add || !summary) return;
        var form = body.closest('form');
        var submit = form.querySelector('[data-cash-submit]');
        function parseAmount(value) { return Number(String(value || '').replace(/[^0-9]/g, '')) || 0; }
        function recalculate() {
          var debit = 0, credit = 0;
          body.querySelectorAll('[data-cash-journal-line]').forEach(function (row) {
            debit += parseAmount(row.querySelector('[name="debit_amount"]').value);
            credit += parseAmount(row.querySelector('[name="credit_amount"]').value);
          });
          var difference = Math.abs(debit - credit);
          summary.querySelector('[data-cash-debit-total]').textContent = debit.toLocaleString();
          summary.querySelector('[data-cash-credit-total]').textContent = credit.toLocaleString();
          summary.querySelector('[data-cash-difference]').textContent = difference.toLocaleString();
          var balanced = debit > 0 && debit === credit;
          summary.dataset.balanced = balanced ? 'true' : 'false';
          summary.querySelector('[data-cash-balance-status]').textContent = balanced ? summary.dataset.balancedMessage : summary.dataset.unbalancedMessage;
          submit.disabled = !balanced;
        }
        add.addEventListener('click', function () {
          var row = body.querySelector('[data-cash-journal-line]').cloneNode(true);
          row.querySelector('select').selectedIndex = 0;
          row.querySelectorAll('input').forEach(function (input) { input.value = ''; });
          body.appendChild(row);
          recalculate();
        });
        body.addEventListener('click', function (event) {
          if (event.target.matches('[data-cash-remove-line]') && body.querySelectorAll('[data-cash-journal-line]').length > 2) {
            event.target.closest('[data-cash-journal-line]').remove();
            recalculate();
          }
        });
        body.addEventListener('input', recalculate);
        body.addEventListener('change', recalculate);
        recalculate();
      })();
      </script>
