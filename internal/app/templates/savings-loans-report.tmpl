{{define "admin-savings-loans-report"}}
{{template "admin-shell-start" .}}
<section class="page-actions"><a class="button-link button-link-secondary" href="/admin/reports">{{t .Lang "reports"}}</a></section>
<section class="panel">
<form class="filter-form" method="get" action="/admin/reports/savings-loans">
<label>{{t .Lang "search"}}<input type="search" name="search" value="{{.Search}}" placeholder="{{t .Lang "search_loans_placeholder"}}"></label>
<label>{{t .Lang "date_from"}}<input type="date" name="date_from" value="{{.DateFrom}}" {{if .DateTo}}max="{{.DateTo}}"{{end}}></label>
<label>{{t .Lang "date_to"}}<input type="date" name="date_to" value="{{.DateTo}}" {{if .DateFrom}}min="{{.DateFrom}}"{{end}}></label>
<button type="submit">{{t .Lang "apply_filters"}}</button>
<button class="button-secondary" type="submit" name="export" value="xlsx">{{t .Lang "export_xlsx"}}</button>
<a class="button-link button-link-secondary" href="/admin/reports/savings-loans">{{t .Lang "reset"}}</a>
</form>
</section>
<section class="panel">
{{if .Rows}}
{{template "table-open" .}}
<thead><tr>
<th>{{t .Lang "member_no"}}</th><th>{{t .Lang "full_name"}}</th>
<th>{{t .Lang "simpanan_pokok"}}</th><th>{{t .Lang "simpanan_wajib"}}</th><th>{{t .Lang "simpanan_manasuka"}}</th><th>{{t .Lang "simpanan_shu_tertahan"}}</th><th>{{t .Lang "simpanan_khusus"}}</th>
<th>{{t .Lang "saving_balance"}}</th><th>{{t .Lang "savings_loans_running_total"}}</th><th>{{t .Lang "savings_loans_remaining_total"}}</th>
</tr></thead>
<tbody>{{range .Rows}}<tr>
<td>{{.MemberNo}}</td><td>{{if index $.Permissions "members.view"}}<a href="/admin/members/{{.MemberID}}">{{.FullName}}</a>{{else}}{{.FullName}}{{end}}</td>
{{template "savings-loans-amount-cells" .}}
</tr>{{end}}</tbody>
<tfoot><tr><th colspan="2">{{t .Lang "total"}}</th>{{template "savings-loans-amount-cells" .Totals}}</tr></tfoot>
{{template "table-close" .}}
{{else}}{{template "empty-state" (t .Lang "savings_loans_empty")}}{{end}}
</section>
{{template "admin-shell-end" .}}
{{end}}

{{define "savings-loans-amount-cells"}}
<td>{{nominal .PokokBalance}}</td><td>{{nominal .WajibBalance}}</td><td>{{nominal .SukarelaBalance}}</td><td>{{nominal .SHUBalance}}</td><td>{{nominal .KhususBalance}}</td><td>{{nominal .SavingsBalance}}</td><td>{{nominal .RunningLoanTotal}}</td><td>{{nominal .RemainingLoanBalance}}</td>
{{end}}
