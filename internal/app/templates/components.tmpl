{{define "summary-card"}}
        <article class="summary-card"><span>{{.Label}}</span><strong>{{.Value}}</strong>{{if .Icon}}<i class="summary-card-icon" data-lucide="{{.Icon}}" aria-hidden="true"></i>{{end}}</article>
{{end}}

{{define "status-badge"}}
<span class="status-badge status-{{.Status}}">{{t .Lang (printf "status_%s" .Status)}}</span>
{{end}}

{{define "empty-state"}}
        <p class="empty-state">{{.}}</p>
{{end}}

{{define "form-error"}}
          <p id="{{.ID}}" class="form-error"></p>
{{end}}

{{define "member-table-cell"}}
<strong>{{.FullName}}</strong><br><span class="table-muted">{{.MemberNo}}</span>
{{end}}

{{define "loan-type-label"}}
{{t .Lang (printf "loan_type_%s" .LoanType)}}{{if .LegacyTerms}} — {{t .Lang "loan_type_legacy_terms"}}{{end}}
{{end}}

{{define "table-open"}}
        <div class="table-scroll">
        <table data-enhanced-table{{if .ServerPaginated}} data-server-paginated{{end}} data-page-label="{{t .Lang "table_page_status"}}" data-previous-label="{{t .Lang "previous_page"}}" data-next-label="{{t .Lang "next_page"}}">
{{end}}

{{define "table-close"}}
        </table>
        </div>
{{end}}

{{define "bar-chart"}}
        <div class="bar-chart report-chart-shell" data-chart="bar" data-chart-format="{{.Format}}">
          {{if .Segments.HasData}}
          <div class="report-chart-visual report-bar-chart-visual">
            <canvas class="report-chart-canvas" role="img" aria-label="{{t .Lang .TitleKey}}"></canvas>
          </div>
          <div class="chart-data" aria-hidden="true">
            {{range .Segments}}
            <span data-chart-item data-label="{{t $.Lang .Label}}" data-value="{{.Value}}" data-color="{{.Class}}"></span>
            {{end}}
          </div>
          {{else}}
{{template "empty-state" (t .Lang "no_report_data")}}
          {{end}}
        </div>
{{end}}

{{define "line-chart"}}
        <article class="line-chart-card {{.Size}}">
          <header class="line-chart-header">
            <h2>{{t .Lang .Chart.TitleKey}}{{if .Chart.TitleSuffix}} {{.Chart.TitleSuffix}}{{end}}</h2>
            <span aria-hidden="true">⋮</span>
          </header>
          <div class="line-chart-body report-chart-shell" data-chart="line">
            <div class="report-chart-visual report-line-chart-visual">
              <canvas class="report-chart-canvas" role="img" aria-label="{{t .Lang .Chart.TitleKey}}"></canvas>
            </div>
            <div class="chart-data" aria-hidden="true">
              {{range .Chart.Labels}}
              <span data-chart-label>{{.}}</span>
              {{end}}
              {{range .Chart.Series}}
              <span data-chart-series data-label="{{t $.Lang .LabelKey}}" data-color="{{.Class}}" data-values="{{range $index, $value := .Values}}{{if $index}},{{end}}{{$value}}{{end}}"></span>
              {{end}}
            </div>
          </div>
        </article>
{{end}}
