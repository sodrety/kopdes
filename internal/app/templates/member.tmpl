{{define "member-dashboard"}}
{{template "member-shell-start" .}}
    <section class="summary-grid">
{{template "summary-card" (dict "Label" (t .Lang "saving_balance") "Value" (nominal .Dashboard.SavingBalance) "Icon" "wallet-cards")}}
{{template "summary-card" (dict "Label" (t .Lang "remaining_loan") "Value" (nominal .Dashboard.RemainingLoanBalance) "Icon" "banknote")}}
{{template "summary-card" (dict "Label" (t .Lang "next_due_date") "Value" .Dashboard.EarliestDueDate "Icon" "calendar-days")}}
{{template "summary-card" (dict "Label" (t .Lang "final_due_date") "Value" .Dashboard.LatestFinalDueDate "Icon" "calendar-check-2")}}
{{if .Dashboard.ActiveLoan}}
{{template "summary-card" (dict "Label" (t .Lang "active_loan") "Value" (nominal .Dashboard.ActiveLoan.ApprovedAmount) "Icon" "landmark")}}
{{else}}
{{template "summary-card" (dict "Label" (t .Lang "active_loan") "Value" (t .Lang "none") "Icon" "landmark")}}
{{end}}
    </section>
    <section class="panel">
      <div class="section-heading-row">
        <div>
          <h2>{{t .Lang "member_slip_exports"}}</h2>
          <p class="field-help">{{t .Lang "member_slip_exports_description"}}</p>
        </div>
      </div>
      <div class="content-grid content-grid-two">
        <form class="form-panel" method="get" action="/member/exports/savings.pdf">
          <button type="submit">{{t .Lang "export_savings_slip"}}</button>
        </form>
        <form class="form-panel" method="get" action="/member/exports/loans.pdf">
          <button type="submit">{{t .Lang "export_loan_slip"}}</button>
        </form>
      </div>
    </section>
    <section class="panel">
      <h2>{{t .Lang "loan_request_status"}}</h2>
      {{if .Dashboard.LoanRequests}}
{{template "table-open" .}}
        <thead>
          <tr>
            <th>{{t $.Lang "amount"}}</th>
            <th>{{t $.Lang "loan_type"}}</th>
            <th>{{t $.Lang "duration"}}</th>
            <th>{{t $.Lang "status"}}</th>
            <th>{{t $.Lang "purpose"}}</th>
            <th>{{t $.Lang "rejection_reason"}}</th>
          </tr>
        </thead>
        <tbody>
          {{range .Dashboard.LoanRequests}}
          <tr>
            <td>{{nominal .RequestedAmount}}</td>
            <td>{{template "loan-type-label" (dict "Lang" $.Lang "LoanType" .LoanType "LegacyTerms" .LegacyTerms)}}</td>
            <td>{{.DurationMonths}} {{t $.Lang "months"}}</td>
            <td>{{template "status-badge" (dict "Lang" $.Lang "Status" .Status)}}</td>
            <td>{{.Purpose}}</td>
            <td>{{.RejectionReason}}</td>
          </tr>
          {{end}}
        </tbody>
{{template "table-close" .}}
      {{else}}
{{template "empty-state" (t .Lang "no_loan_requests")}}
      {{end}}
    </section>
    <section class="panel">
      <h2>{{t .Lang "latest_saving_records"}}</h2>
      {{if .Dashboard.LatestSavings}}
{{template "table-open" .}}
        <thead>
          <tr>
            <th>{{t $.Lang "date"}}</th>
            <th>{{t $.Lang "saving_category"}}</th>
            <th>{{t $.Lang "type"}}</th>
            <th>{{t $.Lang "amount"}}</th>
            <th>{{t $.Lang "reference"}}</th>
          </tr>
        </thead>
        <tbody>
          {{range .Dashboard.LatestSavings}}
          <tr>
            <td>{{.RecordDate}}</td>
            <td>{{t $.Lang (printf "simpanan_%s" .Category)}}</td>
            <td>{{t $.Lang .Type}}</td>
            <td>{{nominal .Amount}}</td>
            <td>{{.ReferenceNo}}</td>
          </tr>
          {{end}}
        </tbody>
{{template "table-close" .}}
      {{else}}
{{template "empty-state" (t .Lang "no_saving_records")}}
      {{end}}
    </section>
    <section class="panel">
      <h2>{{t .Lang "latest_repayment_records"}}</h2>
      {{if .Dashboard.LatestRepayments}}
{{template "table-open" .}}
        <thead>
          <tr>
            <th>{{t $.Lang "date"}}</th>
            <th>{{t $.Lang "repayment_type"}}</th>
            <th>{{t $.Lang "amount"}}</th>
            <th>{{t $.Lang "reference"}}</th>
          </tr>
        </thead>
        <tbody>
          {{range .Dashboard.LatestRepayments}}
          <tr class="{{if eq .Type "adjustment"}}historical-adjustment-row{{else if eq .Type "suspension"}}historical-suspension-row{{end}}">
            <td>{{.RecordDate}}</td>
            <td>{{t $.Lang (printf "repayment_type_%s" .Type)}}</td>
            <td>{{nominal .Amount}}</td>
            <td>{{.ReferenceNo}}</td>
          </tr>
          {{end}}
        </tbody>
{{template "table-close" .}}
      {{else}}
{{template "empty-state" (t .Lang "no_repayment_records")}}
      {{end}}
    </section>
{{template "member-shell-end" .}}
{{end}}

{{define "member-loan-request-detail"}}
{{template "member-shell-start" .}}
    <section class="page-actions">
      <a class="button-link button-link-secondary" href="/member/loan-requests">{{t .Lang "loan_requests"}}</a>
    </section>
    <section class="panel">
      <h2>{{t .Lang "loan_detail"}}</h2>
      <div class="detail-grid">
        <div><span>{{t .Lang "loan_type"}}</span><strong>{{template "loan-type-label" (dict "Lang" .Lang "LoanType" .Request.LoanType "LegacyTerms" .Request.LegacyTerms)}}</strong></div>
        <div><span>{{t .Lang "requested_amount"}}</span><strong>Rp {{nominal .Request.RequestedAmount}}</strong></div>
        <div><span>{{t .Lang "duration"}}</span><strong>{{.Request.DurationMonths}} {{t .Lang "months"}}</strong></div>
        <div><span>{{t .Lang "status"}}</span><strong>{{template "status-badge" (dict "Lang" .Lang "Status" .Request.Status)}}</strong></div>
        <div><span>{{t .Lang "purpose"}}</span><strong>{{.Request.Purpose}}</strong></div>
        {{if .Request.RejectionReason}}<div><span>{{t .Lang "rejection_reason"}}</span><strong>{{.Request.RejectionReason}}</strong></div>{{end}}
      </div>
    </section>
    {{if .Loan}}
    <section class="panel">
      <h2>{{t .Lang "approved_loan"}}</h2>
      <div class="detail-grid">
        <div><span>{{t .Lang "loan_id"}}</span><strong>{{.Loan.ID}}</strong></div>
        <div><span>{{t .Lang "approved_amount"}}</span><strong>Rp {{nominal .Loan.ApprovedAmount}}</strong></div>
        <div><span>{{t .Lang "monthly_installment"}}</span><strong>Rp {{nominal .Loan.MonthlyInstallment}}</strong></div>
        <div><span>{{t .Lang "total_obligation"}}</span><strong>Rp {{nominal .Loan.TotalObligation}}</strong></div>
        <div><span>{{t .Lang "remaining_balance"}}</span><strong>Rp {{nominal .Loan.RemainingBalance}}</strong></div>
        <div><span>{{t .Lang "start_date"}}</span><strong>{{.Loan.StartDate}}</strong></div>
        <div><span>{{t .Lang "next_due_date"}}</span><strong>{{.Loan.NextDueDate}}</strong></div>
        <div><span>{{t .Lang "final_due_date"}}</span><strong>{{.Loan.FinalDueDate}}</strong></div>
        <div><span>{{t .Lang "status"}}</span><strong>{{t .Lang (printf "status_%s" .Loan.Status)}}</strong></div>
      </div>
    </section>
    <section class="panel">
      <h2>{{t .Lang "repayment_history"}}</h2>
      {{if .Repayments}}
{{template "table-open" .}}
        <thead>
          <tr>
            <th>{{t $.Lang "date"}}</th>
            <th>{{t $.Lang "repayment_type"}}</th>
            <th>{{t $.Lang "amount"}}</th>
            <th>{{t $.Lang "reference"}}</th>
            <th>{{t $.Lang "note"}}</th>
          </tr>
        </thead>
        <tbody>
          {{range .Repayments}}
          <tr class="{{if eq .Type "adjustment"}}historical-adjustment-row{{else if eq .Type "suspension"}}historical-suspension-row{{end}}">
            <td>{{.RecordDate}}</td>
            <td>{{t $.Lang (printf "repayment_type_%s" .Type)}}</td>
            <td>{{nominal .Amount}}</td>
            <td>{{.ReferenceNo}}</td>
            <td>{{.Note}}</td>
          </tr>
          {{end}}
        </tbody>
{{template "table-close" .}}
      {{else}}
{{template "empty-state" (t .Lang "no_repayments")}}
      {{end}}
    </section>
    {{else}}
    <section class="panel">
{{template "empty-state" (t .Lang "no_approved_loan")}}
    </section>
    {{end}}
{{template "member-shell-end" .}}
{{end}}

{{define "member-profile"}}
{{template "member-shell-start" .}}
    <section class="profile-identity-card">
      <div class="profile-identity-main">
        <span class="profile-avatar" aria-hidden="true"><i data-lucide="user-round"></i></span>
        <div class="profile-identity-copy">
          <span class="profile-identity-label">{{t .Lang "member_no"}}</span>
          <h2>{{.Member.FullName}}</h2>
          <strong>{{.Member.MemberNo}}</strong>
        </div>
      </div>
      <div class="profile-identity-meta">
        <div>
          <span>{{t .Lang "member_type"}}</span>
          <strong>{{.Member.MemberTypeLabel}}</strong>
        </div>
        <div>
          <span>{{t .Lang "status"}}</span>
          <strong>{{t .Lang .Member.Status}}</strong>
        </div>
      </div>
    </section>
    <section class="summary-grid profile-summary-grid">
{{template "summary-card" (dict "Label" (t .Lang "simpanan_wajib") "Value" (nominal .Summary.WajibBalance) "Icon" "wallet")}}
{{template "summary-card" (dict "Label" (t .Lang "simpanan_manasuka") "Value" (nominal .Summary.SukarelaBalance) "Icon" "coins")}}
{{template "summary-card" (dict "Label" (t .Lang "simpanan_shu_tertahan") "Value" (nominal .Summary.SHUBalance) "Icon" "wallet-cards")}}
{{template "summary-card" (dict "Label" (t .Lang "saving_balance") "Value" (nominal .Summary.CurrentBalance) "Icon" "piggy-bank")}}
{{template "summary-card" (dict "Label" (t .Lang "total_deposits") "Value" (nominal .Summary.TotalDeposit) "Icon" "arrow-down-to-line")}}
{{template "summary-card" (dict "Label" (t .Lang "total_withdrawals") "Value" (nominal .Summary.TotalWithdrawal) "Icon" "arrow-up-from-line")}}
    </section>
    {{if .OutstandingLoans}}
    <section class="panel">
      <h2>{{t .Lang "outstanding_loans"}}</h2>
      {{range .OutstandingLoans}}
      {{if eq .Status "active"}}<p>{{t $.Lang "active_loan"}}</p>{{end}}
      <div class="detail-grid">
        <div><span>{{t $.Lang "loan_type"}}</span><strong>{{template "loan-type-label" (dict "Lang" $.Lang "LoanType" .LoanType "LegacyTerms" .LegacyTerms)}}</strong></div>
        <div><span>{{t $.Lang "approved_amount"}}</span><strong>{{nominal .ApprovedAmount}}</strong></div>
        <div><span>{{t $.Lang "monthly_installment"}}</span><strong>{{nominal .MonthlyInstallment}}</strong></div>
        <div><span>{{t $.Lang "remaining_balance"}}</span><strong>{{nominal .RemainingBalance}}</strong></div>
        <div><span>{{t $.Lang "next_due_date"}}</span><strong>{{.NextDueDate}}</strong></div>
        <div><span>{{t $.Lang "final_due_date"}}</span><strong>{{.FinalDueDate}}</strong></div>
        <div><span>{{t $.Lang "status"}}</span><strong>{{t $.Lang (printf "status_%s" .Status)}}</strong></div>
      </div>
      {{end}}
    </section>
    {{end}}
    <section class="profile-secondary-grid">
      <section class="panel profile-details-panel">
        <h2>{{t .Lang "member_detail"}}</h2>
        <div class="detail-grid">
          <div><span>{{t .Lang "phone"}}</span><strong>{{if .Member.Phone}}{{.Member.Phone}}{{else}}{{t .Lang "none"}}{{end}}</strong></div>
          <div><span>{{t .Lang "address"}}</span><strong>{{if .Member.Address}}{{.Member.Address}}{{else}}{{t .Lang "none"}}{{end}}</strong></div>
          <div><span>{{t .Lang "join_date"}}</span><strong>{{.Member.JoinDate}}</strong></div>
        </div>
      </section>
      <section class="panel form-panel profile-bank-panel">
        <h2>{{t .Lang "bank_details"}}</h2>
        <p class="field-help">{{t .Lang "bank_details_description"}}</p>
        <form method="post" action="/api/member/profile/bank-details" hx-post="/api/member/profile/bank-details" hx-target="#member-bank-details-error" hx-swap="innerHTML">
          <label>{{t .Lang "bank_name"}} <input name="bank_name" value="{{.Member.BankName}}" required autocomplete="organization"></label>
          <label>{{t .Lang "bank_account"}} <input name="bank_account" value="{{.Member.BankAccount}}" inputmode="numeric" required autocomplete="off"></label>
          <button type="submit">{{t .Lang "save_bank_details"}}</button>
        </form>
{{template "form-error" (dict "ID" "member-bank-details-error")}}
      </section>
    </section>
    <section class="panel">
      <h2>{{t .Lang "saving_history"}}</h2>
      {{if .Savings}}
{{template "table-open" .}}
        <thead>
          <tr>
            <th>{{t $.Lang "date"}}</th>
            <th>{{t $.Lang "saving_category"}}</th>
            <th>{{t $.Lang "type"}}</th>
            <th>{{t $.Lang "amount"}}</th>
            <th>{{t $.Lang "reference"}}</th>
            <th>{{t $.Lang "note"}}</th>
          </tr>
        </thead>
        <tbody>
          {{range .Savings}}
          <tr>
            <td>{{.RecordDate}}</td>
            <td>{{t $.Lang (printf "simpanan_%s" .Category)}}</td>
            <td>{{t $.Lang .Type}}</td>
            <td>{{nominal .Amount}}</td>
            <td>{{.ReferenceNo}}</td>
            <td>{{.Note}}</td>
          </tr>
          {{end}}
        </tbody>
{{template "table-close" .}}
      {{else}}
{{template "empty-state" (t .Lang "no_saving_records")}}
      {{end}}
    </section>
    <section class="panel">
      <h2>{{t .Lang "repayment_history"}}</h2>
      {{if .Repayments}}
{{template "table-open" .}}
        <thead>
          <tr>
            <th>{{t $.Lang "date"}}</th>
            <th>{{t $.Lang "repayment_type"}}</th>
            <th>{{t $.Lang "amount"}}</th>
            <th>{{t $.Lang "reference"}}</th>
            <th>{{t $.Lang "note"}}</th>
          </tr>
        </thead>
        <tbody>
          {{range .Repayments}}
          <tr class="{{if eq .Type "adjustment"}}historical-adjustment-row{{else if eq .Type "suspension"}}historical-suspension-row{{end}}">
            <td>{{.RecordDate}}</td>
            <td>{{t $.Lang (printf "repayment_type_%s" .Type)}}</td>
            <td>{{nominal .Amount}}</td>
            <td>{{.ReferenceNo}}</td>
            <td>{{.Note}}</td>
          </tr>
          {{end}}
        </tbody>
{{template "table-close" .}}
      {{else}}
{{template "empty-state" (t .Lang "no_repayments")}}
      {{end}}
    </section>
{{template "member-shell-end" .}}
{{end}}

{{define "member-withdrawal-requests"}}
{{template "member-shell-start" .}}
    <section class="summary-grid">
{{template "summary-card" (dict "Label" (t .Lang "simpanan_sukarela") "Value" (nominal .Summary.SukarelaBalance) "Icon" "coins")}}
{{template "summary-card" (dict "Label" (t .Lang "available_withdrawal_balance") "Value" (nominal .Summary.AvailableWithdrawalBalance) "Icon" "wallet-cards")}}
{{template "summary-card" (dict "Label" (t .Lang "saving_balance") "Value" (nominal .Summary.CurrentBalance) "Icon" "piggy-bank")}}
    </section>
    <section class="two-column">
      <article class="panel">
        <h2>{{t .Lang "submit_withdrawal_request"}}</h2>
        <form method="post" action="/api/member/withdrawal-requests" hx-post="/api/member/withdrawal-requests" hx-target="#withdrawal-request-error" hx-swap="innerHTML">
          <label>{{t .Lang "amount"}}
            <input name="amount" type="text" inputmode="numeric" placeholder="{{t .Lang "rupiah_placeholder"}}" data-rupiah-input data-rupiah-group="{{if eq .Lang "id"}}.{{else}},{{end}}" data-rupiah-invalid="{{t .Lang "error_invalid_rupiah_amount"}}" data-rupiah-max="{{.Summary.AvailableWithdrawalBalance}}" data-rupiah-max-invalid="{{t .Lang "error_withdrawal_amount_over_available"}}" aria-describedby="withdrawal-amount-hint" aria-errormessage="withdrawal-amount-error" autocomplete="off" spellcheck="false" required>
            <small id="withdrawal-amount-hint">{{t .Lang "rupiah_input_hint"}}</small>
            <small id="withdrawal-amount-error" class="form-error-message" aria-live="polite" hidden></small>
          </label>
          <label>{{t .Lang "note"}} <input name="note"></label>
          <button type="submit">{{t .Lang "submit_withdrawal_request"}}</button>
        </form>
{{template "form-error" (dict "ID" "withdrawal-request-error")}}
      </article>
      <article class="panel">
        <h2>{{t .Lang "withdrawal_request_history"}}</h2>
        {{if .WithdrawalRequests}}
{{template "table-open" .}}
          <thead>
            <tr>
              <th>{{t $.Lang "amount"}}</th>
              <th>{{t $.Lang "status"}}</th>
              <th>{{t $.Lang "note"}}</th>
              <th>{{t $.Lang "rejection_reason"}}</th>
              <th>{{t $.Lang "review"}}</th>
            </tr>
          </thead>
          <tbody>
            {{range .WithdrawalRequests}}
            <tr>
              <td>{{nominal .Amount}}</td>
              <td>{{template "status-badge" (dict "Lang" $.Lang "Status" .Status)}}</td>
              <td>{{.Note}}</td>
              <td>{{.RejectionReason}}</td>
              <td>{{if .CurrentApprovalStage}}{{t $.Lang "awaiting"}} {{t $.Lang (printf "role_%s" .CurrentApprovalStage)}}{{end}}{{if .LatestDecision}}<div>{{t $.Lang (printf "role_%s" .LatestDecision.OfficerRole)}} — {{t $.Lang (printf "status_%s" .LatestDecision.Decision)}} — {{.LatestDecision.CreatedAt}}{{if .LatestDecision.Note}} · {{.LatestDecision.Note}}{{end}}{{if .LatestDecision.Reason}} · {{.LatestDecision.Reason}}{{end}}</div>{{end}}{{if eq .Status "pending"}}<form method="post" action="/api/member/withdrawal-requests/{{.ID}}/cancel" hx-post="/api/member/withdrawal-requests/{{.ID}}/cancel"><button class="button-secondary" type="submit">{{t $.Lang "cancel"}}</button></form>{{end}}</td>
            </tr>
            {{end}}
          </tbody>
{{template "table-close" .}}
        {{else}}
{{template "empty-state" (t .Lang "no_withdrawal_requests")}}
        {{end}}
      </article>
    </section>
{{template "member-shell-end" .}}
{{end}}

{{define "member-loan-requests"}}
{{template "member-shell-start" .}}
    <section class="two-column">
      <article class="panel">
        <h2>{{t .Lang "submit_loan_request"}}</h2>
        {{if not .BankDetailsReady}}
        <div class="form-notice" role="alert">
          <p>{{t .Lang "bank_details_required_before_loan"}}</p>
          <a class="button-link button-link-secondary" href="/member/profile">{{t .Lang "profile"}}</a>
        </div>
        {{else if eq .MaxLoanAmount 0}}
        <div class="form-notice" role="alert">
          <p>{{t .Lang "no_saving_balance_for_loan"}}</p>
        </div>
        {{end}}
        <form method="post" action="/api/member/loan-requests" hx-post="/api/member/loan-requests" hx-target="#loan-request-error" hx-swap="innerHTML" data-loan-fee-preview data-monthly-installment-label="{{t .Lang "loan_request_monthly_installment"}}" data-total-admin-fee-label="{{t .Lang "total_admin_fee"}}" data-total-obligation-label="{{t .Lang "total_obligation"}}" data-rupiah-group="{{if eq .Lang "id"}}.{{else}},{{end}}">
          <label>{{t .Lang "loan_type"}} <select name="loan_type" data-loan-type required><option value="">{{t .Lang "select_loan_type"}}</option><option value="regular">{{t .Lang "loan_type_regular"}}</option><option value="secondary_goods">{{t .Lang "loan_type_secondary_goods"}}</option><option value="goods_purchase_paylater">{{t .Lang "loan_type_goods_purchase_paylater"}}</option></select></label>
		  <label>{{t .Lang "requested_amount"}}
            <input name="requested_amount" type="text" inputmode="numeric" placeholder="{{t .Lang "rupiah_placeholder"}}" data-rupiah-input data-loan-amount data-rupiah-group="{{if eq .Lang "id"}}.{{else}},{{end}}" data-rupiah-invalid="{{t .Lang "error_invalid_rupiah_amount"}}" data-rupiah-max="{{.MaxLoanAmount}}" data-rupiah-max-invalid="{{t .Lang "error_loan_amount_limit"}}" aria-describedby="loan-request-amount-hint" aria-errormessage="loan-request-amount-error" autocomplete="off" spellcheck="false" {{if not .BankDetailsReady}}disabled{{end}} required>
            <small id="loan-request-amount-hint">{{t .Lang "loan_amount_limit_hint"}}</small>
            <small id="loan-request-amount-error" class="form-error-message" aria-live="polite" hidden></small>
          </label>
		  <label>{{t .Lang "duration_months"}} <input name="duration_months" type="number" min="1" max="24" data-loan-duration required></label>
          <p class="loan-fee-preview" data-loan-fee-output aria-live="polite" hidden></p>
		  <label>{{t .Lang "purpose"}} <input name="purpose" required></label>
          <button type="submit" {{if or (not .BankDetailsReady) (eq .MaxLoanAmount 0)}}disabled{{end}}>{{t .Lang "submit_loan_request"}}</button>
        </form>
{{template "form-error" (dict "ID" "loan-request-error")}}
      </article>
      <article class="panel">
        <h2>{{t .Lang "request_history"}}</h2>
        {{if .LoanRequests}}
{{template "table-open" .}}
          <thead>
            <tr>
              <th>{{t $.Lang "amount"}}</th>
              <th>{{t $.Lang "loan_type"}}</th>
              <th>{{t $.Lang "duration"}}</th>
              <th>{{t $.Lang "status"}}</th>
              <th>{{t $.Lang "purpose"}}</th>
              <th>{{t $.Lang "details"}}</th>
              <th>{{t $.Lang "review"}}</th>
            </tr>
          </thead>
          <tbody>
            {{range .LoanRequests}}
            <tr>
              <td>{{nominal .RequestedAmount}}</td>
              <td>{{template "loan-type-label" (dict "Lang" $.Lang "LoanType" .LoanType "LegacyTerms" .LegacyTerms)}}</td>
              <td>{{.DurationMonths}}</td>
              <td>{{template "status-badge" (dict "Lang" $.Lang "Status" .Status)}}</td>
              <td>{{.Purpose}}</td>
              <td><a class="button-link button-link-secondary" href="/member/loan-requests/{{.ID}}">{{t $.Lang "view_details"}}</a></td>
              <td>{{if .CurrentApprovalStage}}{{t $.Lang "awaiting"}} {{t $.Lang (printf "role_%s" .CurrentApprovalStage)}}{{end}}{{if .LatestDecision}}<div>{{t $.Lang (printf "role_%s" .LatestDecision.OfficerRole)}} — {{t $.Lang (printf "status_%s" .LatestDecision.Decision)}} — {{.LatestDecision.CreatedAt}}{{if .LatestDecision.Note}} · {{.LatestDecision.Note}}{{end}}{{if .LatestDecision.Reason}} · {{.LatestDecision.Reason}}{{end}}</div>{{end}}{{if eq .Status "pending"}}<form method="post" action="/api/member/loan-requests/{{.ID}}/cancel" hx-post="/api/member/loan-requests/{{.ID}}/cancel"><button class="button-secondary" type="submit">{{t $.Lang "cancel"}}</button></form>{{end}}</td>
            </tr>
            {{end}}
          </tbody>
{{template "table-close" .}}
        {{else}}
{{template "empty-state" (t .Lang "no_loan_requests")}}
        {{end}}
      </article>
    </section>
{{template "member-shell-end" .}}
{{end}}
